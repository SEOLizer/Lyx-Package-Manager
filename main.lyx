// main.lyx — lpm Einstiegspunkt
// Lyx Package Manager v0.1.0

@description("lpm — Lyx Package Manager entry point")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
// network.udp.connect ist kein Tippfehler: die Namensaufloesung vor jedem
// HTTPS-Request laeuft ueber UDP. Fehlt sie, kennt der seccomp-Filter den
// socket(AF_INET, SOCK_DGRAM) nicht und der Prozess stirbt wortlos an SIGSYS.
// fs.meta braucht OpenSSL fuer den CA-Store unter /usr/lib/ssl/certs.
// fs.perm braucht das chmod auf ~/.lpm/credentials — die Datei mit dem
// Registry-Token soll 0600 sein und nicht die ueblichen 0644.
@capabilities([fs.read, fs.write, fs.create, fs.delete, fs.meta, fs.perm, system.env, system.exit,
               network.tcp.connect, network.udp.connect, memory.mmap, system.time])
unit main;

import std.io grant [fs.read, fs.write];
import lpm.cli.commands grant [fs.read, fs.write, fs.create, fs.delete, fs.meta, fs.perm, system.env, system.exit,
                               network.tcp.connect, network.udp.connect, memory.mmap, system.time];

pub fn main(argc: int64, argv: pchar): int64 {
  return lpmMain(argc, argv);
}
