// ---------------------------------------------------------------------------
// [build.units]: Menge und Ueberlauf (Issue #3)
// ---------------------------------------------------------------------------

// Ein mehrstufiger Unit-Schluessel (Issue #2): in der lyx.toml gequotet, weil
// TOML den Punkt sonst als Tabellentrenner liest. Die Tabelle muss ihn genau
// so wieder herausgeben — `lpm resolve vega.backend.x11` schlaegt ihn als
// "backend.x11" nach.
fn testDottedUnitKey(): void {
  outLn("[build.units] mit Punkt im Schluessel (Issue #2)"c);

  Mkdir(TMP, 493);
  writeFile("tests-tmp/punkt.toml"c,
            "[package]\nname = \"vega\"\nversion = \"0.2.0\"\n\n[build]\nentry = \"vega.lyx\"\n\n[build.units]\nforms = \"vega/forms.lyx\"\n\"backend.x11\" = \"vega/backend/x11.lyx\"\n"c);

  var mf: Manifest := new Manifest();
  mf.MfInit();
  ok("gelesen"c, mf.MfRead("tests-tmp/punkt.toml"c));
  okInt("zwei Units"c, mf.MfUnitCount(), 2);
  okStr("einstufig"c, mf.MfFindUnit("forms"c), "vega/forms.lyx"c);
  okStr("zweistufig"c, mf.MfFindUnit("backend.x11"c), "vega/backend/x11.lyx"c);
  ok("nicht als Pfad verbogen"c, mf.MfFindUnit("backend/x11"c) == 0 as pchar);

  // Schreiben und wieder lesen: das Quoting muss erhalten bleiben.
  ok("geschrieben"c, mf.MfWrite("tests-tmp/punkt2.toml"c));
  var mf2: Manifest := new Manifest();
  mf2.MfInit();
  ok("wieder gelesen"c, mf2.MfRead("tests-tmp/punkt2.toml"c));
  okStr("zweistufig ueberlebt"c, mf2.MfFindUnit("backend.x11"c),
        "vega/backend/x11.lyx"c);

  mf2.MfFree(); dispose mf2;
  mf.MfFree(); dispose mf;
  DeleteFile("tests-tmp/punkt.toml"c);
  DeleteFile("tests-tmp/punkt2.toml"c);
}

fn testUnitLimit(): void {
  outLn("[build.units] (Issue #3)"c);

  var mf: Manifest := new Manifest();
  mf.MfInit();

  // 500 Units, so viele hat die Standardbibliothek. Mit der alten Grenze 32
  // waeren 468 davon stillschweigend verschwunden.
  var name: int64 := alloc(PK_T_PATH);
  var file: int64 := alloc(PK_T_PATH);
  var i: int64 := 0;
  var added: int64 := 0;
  while i < 500 {
    limitPath(name, "u"c, i);        // "u/f<i>.lyx" — als Name gut genug
    limitPath(file, "src"c, i);
    if mf.MfAddUnit(name as pchar, file as pchar) { added := added + 1; }
    i := i + 1;
  }
  okInt("500 Units aufgenommen"c, added, 500);
  okInt("MfUnitCount stimmt"c, mf.MfUnitCount(), 500);
  okInt("nichts verloren"c, mf.MfUnitsLost(), 0);

  // Ueberlauf: bis MF_MAX_UNITS auffuellen, dann drei Eintraege darueber.
  while i < MF_MAX_UNITS {
    limitPath(name, "u"c, i);
    limitPath(file, "src"c, i);
    mf.MfAddUnit(name as pchar, file as pchar);
    i := i + 1;
  }
  okInt("voll bei MF_MAX_UNITS"c, mf.MfUnitCount(), MF_MAX_UNITS);

  var over: int64 := 0;
  var k: int64 := 0;
  while k < 3 {
    limitPath(name, "u"c, MF_MAX_UNITS + k);
    limitPath(file, "src"c, MF_MAX_UNITS + k);
    if !mf.MfAddUnit(name as pchar, file as pchar) { over := over + 1; }
    k := k + 1;
  }
  okInt("Ueberlauf wird gemeldet"c, over, 3);
  okInt("und gezaehlt"c, mf.MfUnitsLost(), 3);
  okInt("keiner heimlich dazugekommen"c, mf.MfUnitCount(), MF_MAX_UNITS);
  ok("PK_ERR_UNITS hat einen Text"c, PkErrStr(PK_ERR_UNITS) != 0 as pchar);

  free(file, PK_T_PATH);
  free(name, PK_T_PATH);
  mf.MfFree(); dispose mf;
}

// ---------------------------------------------------------------------------
// [build.provides] (Issue #6)
// ---------------------------------------------------------------------------
//
// Geprueft wird die Manifestseite: lesen, nachschlagen, schreiben, wieder
// lesen. Dass `lpm resolve` daraus den Pfad baut und bei zwei Paketen mit
// demselben Eintrag abbricht, ist CLI-Verhalten und steht im Handbuch.

fn testProvides(): void {
  outLn("[build.provides] (Issue #6)"c);

  Mkdir(TMP, 493);
  writeFile("tests-tmp/prov.toml"c,
            "[package]\nname = \"lyx-std-dev\"\nversion = \"0.1.0\"\n\n[build]\nentry = \"std/io.lyx\"\n\n[build.provides]\nstd = \"std\"\ndata = \"data\"\n"c);

  var mf: Manifest := new Manifest();
  mf.MfInit();
  ok("gelesen"c, mf.MfRead("tests-tmp/prov.toml"c));
  okStr("Paket heisst weiter lyx-std-dev"c, mf.MfName(), "lyx-std-dev"c);
  okInt("zwei Importnamen"c, mf.MfProvCount(), 2);
  okStr("std -> std"c,   mf.MfFindProvide("std"c),  "std"c);
  okStr("data -> data"c, mf.MfFindProvide("data"c), "data"c);
  ok("nichts erfunden"c, mf.MfFindProvide("vega"c) == 0 as pchar);
  okInt("nichts verloren"c, mf.MfProvLost(), 0);

  // Der Abschnitt muss das Schreiben ueberleben: lpm init und lpm install
  // schreiben das Manifest neu.
  ok("geschrieben"c, mf.MfWrite("tests-tmp/prov2.toml"c));
  var mf2: Manifest := new Manifest();
  mf2.MfInit();
  ok("wieder gelesen"c, mf2.MfRead("tests-tmp/prov2.toml"c));
  okInt("immer noch zwei"c, mf2.MfProvCount(), 2);
  okStr("std ueberlebt"c, mf2.MfFindProvide("std"c), "std"c);
  okStr("entry bleibt daneben"c, mf2.MfEntry(), "std/io.lyx"c);

  mf2.MfFree(); dispose mf2;
  mf.MfFree(); dispose mf;

  // Ueberlauf: MF_MAX_PROV ist die Grenze, und sie wird gemeldet.
  var mf3: Manifest := new Manifest();
  mf3.MfInit();
  var name: int64 := alloc(PK_T_PATH);
  var i: int64 := 0;
  while i < MF_MAX_PROV {
    limitPath(name, "p"c, i);
    mf3.MfAddProvide(name as pchar, "dir"c);
    i := i + 1;
  }
  okInt("voll bei MF_MAX_PROV"c, mf3.MfProvCount(), MF_MAX_PROV);
  ok("einer darueber wird abgewiesen"c, !mf3.MfAddProvide("nochwas"c, "dir"c));
  okInt("und gezaehlt"c, mf3.MfProvLost(), 1);
  free(name, PK_T_PATH);
  mf3.MfFree(); dispose mf3;

  DeleteFile("tests-tmp/prov.toml"c);
  DeleteFile("tests-tmp/prov2.toml"c);
}

// ---------------------------------------------------------------------------
// Grosses Manifest: lesen und schreiben ohne Verlust
// ---------------------------------------------------------------------------
//
// MF_BUF_SZ waren 8 KiB, fest, fuer BEIDE Richtungen. Mit 4096 moeglichen
// Units hiess das: ein Manifest mit einigen hundert Eintraegen wurde beim
// Lesen abgeschnitten (und galt als vollstaendig), beim Schreiben lief es
// hinter den Puffer. Beides faellt hier auf.

fn testBigManifest(): void {
  outLn("grosses Manifest (ueber 8 KiB)"c);

  Mkdir(TMP, 493);
  // Name und Version kommen aus einer gelesenen Datei — Setter gibt es nicht.
  writeFile("tests-tmp/gross-kopf.toml"c,
            "[package]\nname = \"demo/gross\"\nversion = \"1.0.0\"\n"c);
  var mf: Manifest := new Manifest();
  mf.MfInit();
  ok("Kopf gelesen"c, mf.MfRead("tests-tmp/gross-kopf.toml"c));

  // 500 Units wie in der Standardbibliothek: je Zeile rund 40 Byte, also
  // etwa 20 KiB — mehr als das Doppelte des alten Puffers.
  var name: int64 := alloc(PK_T_PATH);
  var file: int64 := alloc(PK_T_PATH);
  var i: int64 := 0;
  while i < 500 {
    limitPath(name, "u"c, i);
    limitPath(file, "src"c, i);
    mf.MfAddUnit(name as pchar, file as pchar);
    i := i + 1;
  }
  okInt("500 Units im Speicher"c, mf.MfUnitCount(), 500);
  ok("geschrieben"c, mf.MfWrite("tests-tmp/gross.toml"c));
  ok("Datei ist groesser als der alte Puffer"c,
     FileSize("tests-tmp/gross.toml"c) > 8192);

  var mf2: Manifest := new Manifest();
  mf2.MfInit();
  ok("wieder gelesen"c, mf2.MfRead("tests-tmp/gross.toml"c));
  okStr("Name ueberlebt"c, mf2.MfName(), "demo/gross"c);
  okInt("alle 500 kamen zurueck"c, mf2.MfUnitCount(), 500);
  okInt("nichts verloren"c, mf2.MfUnitsLost(), 0);

  // Stichproben am Anfang, in der Mitte und am Ende — ein abgeschnittenes
  // Manifest verliert genau das Ende.
  limitPath(name, "u"c, 1);   limitPath(file, "src"c, 1);
  okStr("erster Eintrag"c, mf2.MfFindUnit(name as pchar), file as pchar);
  limitPath(name, "u"c, 250); limitPath(file, "src"c, 250);
  okStr("mittlerer Eintrag"c, mf2.MfFindUnit(name as pchar), file as pchar);
  limitPath(name, "u"c, 499); limitPath(file, "src"c, 499);
  okStr("letzter Eintrag"c, mf2.MfFindUnit(name as pchar), file as pchar);

  free(file, PK_T_PATH);
  free(name, PK_T_PATH);
  mf2.MfFree(); dispose mf2;
  mf.MfFree(); dispose mf;
  DeleteFile("tests-tmp/gross.toml"c);
  DeleteFile("tests-tmp/gross-kopf.toml"c);
}

