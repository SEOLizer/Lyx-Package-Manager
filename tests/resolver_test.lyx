// ---------------------------------------------------------------------------
// 6. Keine Version erfuellt das Constraint
// ---------------------------------------------------------------------------

fn testNoVersion(): void {
  outLn("keine passende Version"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();
  cat.DcAddPkg("A"c, "1.0.0"c, "x"c, "s"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  r.RsAddRoot("A"c, "^9.0.0"c);
  var rc: int64 := r.RsResolve();

  ok("meldet Konflikt"c, rc == RS_ERR_CONFLICT);
