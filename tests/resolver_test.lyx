fn testCycle(): void {
  outLn("zyklische Abhaengigkeit"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();
  var a: int64 := cat.DcAddPkg("A"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(a, "B"c, "^1.0.0"c);
  var b: int64 := cat.DcAddPkg("B"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(b, "A"c, "^1.0.0"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  r.RsAddRoot("A"c, "^1.0.0"c);
  var rc: int64 := r.RsResolve();

  ok("meldet Zyklus"c, rc == RS_ERR_CYCLE);

  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;
}

// ---------------------------------------------------------------------------
// 8. Nachtraegliche Verschaerfung: erst ^1.0.0, dann ~1.2.0
// ---------------------------------------------------------------------------

fn testTighten(): void {
  outLn("nachtraeglich verschaerftes Constraint"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();

  var a: int64 := cat.DcAddPkg("A"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(a, "C"c, "~1.2.0"c);
  cat.DcAddPkg("C"c, "1.2.5"c, "x"c, "s"c);
  cat.DcAddPkg("C"c, "1.9.0"c, "x"c, "s"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  // Root fordert nur ^1.0.0 — zuerst wuerde 1.9.0 gewaehlt, A verschaerft dann.
  r.RsAddRoot("C"c, "^1.0.0"c);
  r.RsAddRoot("A"c, "^1.0.0"c);
  var rc: int64 := r.RsResolve();

  ok("aufgeloest"c, rc == RS_OK);
  okStr("faellt auf 1.2.5 zurueck"c, r.RsVer(0), "1.2.5"c);

  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;
}

// ---------------------------------------------------------------------------
// 9. Lock-File-Uebergabe
// ---------------------------------------------------------------------------

fn testToLock(): void {
  outLn("Ergebnis ins LockFile"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();
  var a: int64 := cat.DcAddPkg("net/http"c, "1.2.0"c, "deadbeef"c, "https://lpm.seolizer.de/packages/net/http/1.2.0.lxpkg"c);
  cat.DcAddDep(a, "std/io"c, "^1.0.0"c);
  cat.DcAddPkg("std/io"c, "1.4.0"c, "cafe"c, "https://lpm.seolizer.de/packages/std/io/1.4.0.lxpkg"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  r.RsAddRoot("net/http"c, "^1.0.0"c);
  var rc: int64 := r.RsResolve();
  ok("aufgeloest"c, rc == RS_OK);

  var lock: LockFile := new LockFile();
  lock.LfInit();
  r.RsToLock(lock);

  var idx: int64 := lock.LfFind("net/http"c);
  ok("net/http im Lock"c, idx >= 0);
  okStr("Version gepinnt"c, lock.LfGetVer(idx), "1.2.0"c);
  okStr("sha256 gepinnt"c, lock.LfGetSha256(idx), "deadbeef"c);
  okStr("Quelle gepinnt"c, lock.LfGetSrc(idx),
        "https://lpm.seolizer.de/packages/net/http/1.2.0.lxpkg"c);

  lock.LfFree(); dispose lock;
  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;
}

// ---------------------------------------------------------------------------
// 10. Determinismus: zweimal derselbe Katalog -> dieselbe Auswahl
// ---------------------------------------------------------------------------

fn resolveTwice(): bool {
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();
  var a: int64 := cat.DcAddPkg("A"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(a, "C"c, "^1.0.0"c);
  var b: int64 := cat.DcAddPkg("B"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(b, "C"c, "^1.1.0"c);
  cat.DcAddPkg("C"c, "1.1.0"c, "x"c, "s"c);
  cat.DcAddPkg("C"c, "1.5.0"c, "x"c, "s"c);

  var r1: Resolver := new Resolver();
  r1.RsInit(cat);
  r1.RsAddRoot("A"c, "^1.0.0"c);
  r1.RsAddRoot("B"c, "^1.0.0"c);
  r1.RsResolve();

  var r2: Resolver := new Resolver();
  r2.RsInit(cat);
  r2.RsAddRoot("A"c, "^1.0.0"c);
  r2.RsAddRoot("B"c, "^1.0.0"c);
  r2.RsResolve();

  var same: bool := r1.RsCount() == r2.RsCount();
  var i: int64 := 0;
  while i < r1.RsCount() {
    if StrCmp(r1.RsName(i), r2.RsName(i)) != 0 { same := false; }
    if StrCmp(r1.RsVer(i),  r2.RsVer(i))  != 0 { same := false; }
    i := i + 1;
  }

  r1.RsFree(); dispose r1;
  r2.RsFree(); dispose r2;
  cat.DcFree(); dispose cat;
  return same;
}

fn testDeterminism(): void {
  outLn("Determinismus"c);
  ok("zwei Laeufe, gleiches Ergebnis"c, resolveTwice());
}

// ---------------------------------------------------------------------------
// LfDiff — die Grundlage der Aenderungsmeldung von `lpm update`
// ---------------------------------------------------------------------------
//
// Geprueft wird die reine Vergleichslogik, ohne Datei und ohne Netz: zwei
// LockFile-Objekte werden von Hand gefuellt und verglichen.

con DIFF_MAX: int64 := 32;

// Legt ein Lock mit den uebergebenen Paketen an. Die Argumente kommen paarweise
// (Name, Version); ein leerer Name beendet die Liste.
fn lockOf3(n1: pchar, v1: pchar, n2: pchar, v2: pchar, n3: pchar, v3: pchar): LockFile {
  var lf: LockFile := new LockFile();
  lf.LfInit();
  if StrLen(n1) > 0 { lf.LfAddPkg(n1, v1, "sha"c, "src"c); }
  if StrLen(n2) > 0 { lf.LfAddPkg(n2, v2, "sha"c, "src"c); }
  if StrLen(n3) > 0 { lf.LfAddPkg(n3, v3, "sha"c, "src"c); }
  return lf;
}

fn testDiffUnchanged(): void {
  outLn("LfDiff: unveraendert"c);
  var a: LockFile := lockOf3("demo/base"c, "1.0.0"c, "demo/mid"c, "1.1.0"c, ""c, ""c);
  var b: LockFile := lockOf3("demo/base"c, "1.0.0"c, "demo/mid"c, "1.1.0"c, ""c, ""c);

  var kinds: int64 := alloc(DIFF_MAX * 8);
  var names: int64 := alloc(DIFF_MAX * 8);
  var olds:  int64 := alloc(DIFF_MAX * 8);
  var news:  int64 := alloc(DIFF_MAX * 8);

  okInt("keine Aenderung"c, a.LfDiff(b, kinds, names, olds, news, DIFF_MAX), 0);

  free(news, DIFF_MAX * 8); free(olds, DIFF_MAX * 8);
  free(names, DIFF_MAX * 8); free(kinds, DIFF_MAX * 8);
  a.LfFree(); dispose a; b.LfFree(); dispose b;
}

fn testDiffChanged(): void {
  outLn("LfDiff: Version gewechselt"c);
  var a: LockFile := lockOf3("demo/base"c, "1.0.0"c, "demo/mid"c, "1.1.0"c, ""c, ""c);
  var b: LockFile := lockOf3("demo/base"c, "1.5.0"c, "demo/mid"c, "1.1.0"c, ""c, ""c);

  var kinds: int64 := alloc(DIFF_MAX * 8);
  var names: int64 := alloc(DIFF_MAX * 8);
  var olds:  int64 := alloc(DIFF_MAX * 8);
  var news:  int64 := alloc(DIFF_MAX * 8);

  okInt("eine Aenderung"c, a.LfDiff(b, kinds, names, olds, news, DIFF_MAX), 1);
  okInt("als CHANGED gemeldet"c, peek64(kinds), LF_DIFF_CHANGED);
  okStr("richtiges Paket"c, peek64(names) as pchar, "demo/base"c);
  okStr("alte Version"c, peek64(olds) as pchar, "1.0.0"c);
  okStr("neue Version"c, peek64(news) as pchar, "1.5.0"c);

  free(news, DIFF_MAX * 8); free(olds, DIFF_MAX * 8);
  free(names, DIFF_MAX * 8); free(kinds, DIFF_MAX * 8);
  a.LfFree(); dispose a; b.LfFree(); dispose b;
}

fn testDiffAddedRemoved(): void {
  outLn("LfDiff: hinzu und weggefallen"c);
  var a: LockFile := lockOf3("demo/base"c, "1.0.0"c, "demo/alt"c, "0.9.0"c, ""c, ""c);
  var b: LockFile := lockOf3("demo/base"c, "1.0.0"c, "demo/neu"c, "2.0.0"c, ""c, ""c);

  var kinds: int64 := alloc(DIFF_MAX * 8);
  var names: int64 := alloc(DIFF_MAX * 8);
  var olds:  int64 := alloc(DIFF_MAX * 8);
  var news:  int64 := alloc(DIFF_MAX * 8);

  okInt("zwei Aenderungen"c, a.LfDiff(b, kinds, names, olds, news, DIFF_MAX), 2);

  // Reihenfolge: erst das neue Lock durchgehen (ADDED), dann das alte (REMOVED).
  okInt("erst ADDED"c, peek64(kinds), LF_DIFF_ADDED);
  okStr("das neue Paket"c, peek64(names) as pchar, "demo/neu"c);
  ok("ADDED hat keine alte Version"c, peek64(olds) == 0);

  okInt("dann REMOVED"c, peek64(kinds + 8), LF_DIFF_REMOVED);
  okStr("das weggefallene"c, peek64(names + 8) as pchar, "demo/alt"c);
  okStr("mit seiner letzten Version"c, peek64(olds + 8) as pchar, "0.9.0"c);
  ok("REMOVED hat keine neue Version"c, peek64(news + 8) == 0);

  free(news, DIFF_MAX * 8); free(olds, DIFF_MAX * 8);
  free(names, DIFF_MAX * 8); free(kinds, DIFF_MAX * 8);
  a.LfFree(); dispose a; b.LfFree(); dispose b;
}

fn testDiffEdges(): void {
  outLn("LfDiff: Randfaelle"c);
  var kinds: int64 := alloc(DIFF_MAX * 8);
  var names: int64 := alloc(DIFF_MAX * 8);
  var olds:  int64 := alloc(DIFF_MAX * 8);
  var news:  int64 := alloc(DIFF_MAX * 8);

  // Erster Lauf ueberhaupt: vorher leer, alles ist neu.
  var leer: LockFile := lockOf3(""c, ""c, ""c, ""c, ""c, ""c);
  var voll: LockFile := lockOf3("a/b"c, "1.0.0"c, "c/d"c, "2.0.0"c, ""c, ""c);
  okInt("aus leer wird alles ADDED"c,
        leer.LfDiff(voll, kinds, names, olds, news, DIFF_MAX), 2);

  // Und umgekehrt: alles weg.
  okInt("nach leer ist alles REMOVED"c,
        voll.LfDiff(leer, kinds, names, olds, news, DIFF_MAX), 2);
  okInt("Art stimmt"c, peek64(kinds), LF_DIFF_REMOVED);

  // Die Obergrenze wird eingehalten, statt ueber das Array hinauszuschreiben.
  okInt("max wird beachtet"c, voll.LfDiff(leer, kinds, names, olds, news, 1), 1);

  leer.LfFree(); dispose leer; voll.LfFree(); dispose voll;
  free(news, DIFF_MAX * 8); free(olds, DIFF_MAX * 8);
  free(names, DIFF_MAX * 8); free(kinds, DIFF_MAX * 8);
}

// ---------------------------------------------------------------------------

pub fn main(argc: int64, argv: pchar): int64 {
  outLn("resolver tests"c);
  outLn(""c);
  testChain();
  testHighest();
  testDiamondOk();
  testDiamondConflict();
  testMissing();
  testNoVersion();
  testCycle();
  testTighten();
  testToLock();
  testDeterminism();
  testDiffUnchanged();
  testDiffChanged();
  testDiffAddedRemoved();
  testDiffEdges();

  outLn(""c);
  out("bestanden: "c); PrintInt(tsPass);
  out("   fehlgeschlagen: "c); PrintInt(tsFail);
  outLn(""c);

  if tsFail > 0 { return 1; }
  return 0;
}
