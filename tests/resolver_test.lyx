// tests/resolver_test.lyx
// WP-PM-04: Tests fuer den Resolver. Laeuft ohne Netzwerk und ohne
// Dateisystem — der Katalog wird direkt befuellt.
//
// Bauen und ausfuehren:  make test

@description("lpm resolver tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write, system.exit])
unit main;

import std.io grant [fs.read, fs.write];
import lpm.core.semver grant [fs.read, fs.write];
import lpm.core.lockfile grant [fs.read, fs.write];
import lpm.core.resolver grant [fs.read, fs.write];

var tsPass: int64 := 0;
var tsFail: int64 := 0;

fn out(s: pchar): void {
  if s == 0 as pchar { sys_write(1, "(null)"c as int64, 6); return; }
  sys_write(1, s as int64, StrLen(s));
}
fn outLn(s: pchar): void { out(s); sys_write(1, "\n"c as int64, 1); }

fn ok(name: pchar, cond: bool): void {
  if cond {
    tsPass := tsPass + 1;
    out("  ok   "c); outLn(name);
  } else {
    tsFail := tsFail + 1;
    out("  FAIL "c); outLn(name);
  }
}

fn okStr(name: pchar, got: pchar, want: pchar): void {
  var same: bool := false;
  if got != 0 as pchar {
    if StrCmp(got, want) == 0 { same := true; }
  }
  if same {
    tsPass := tsPass + 1;
    out("  ok   "c); outLn(name);
  } else {
    tsFail := tsFail + 1;
    out("  FAIL "c); out(name); out("  erwartet="c); out(want);
    out(" bekommen="c); outLn(got);
  }
}

fn okInt(name: pchar, got: int64, want: int64): void {
  if got == want {
    tsPass := tsPass + 1;
    out("  ok   "c); outLn(name);
  } else {
    tsFail := tsFail + 1;
    out("  FAIL "c); out(name); out("  erwartet="c); PrintInt(want);
    out(" bekommen="c); PrintInt(got); outLn(""c);
  }
}

// ---------------------------------------------------------------------------
// 1. Transitive Kette ueber drei Stufen: app -> net/http -> std/io -> std/core
// ---------------------------------------------------------------------------

fn testChain(): void {
  outLn("Kette ueber drei Stufen"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();

  var a: int64 := cat.DcAddPkg("net/http"c, "1.2.0"c, "aa"c, "https://lpm.seolizer.de/packages/net/http/1.2.0.lxpkg"c);
  cat.DcAddDep(a, "std/io"c, "^1.0.0"c);
  var b: int64 := cat.DcAddPkg("std/io"c, "1.4.0"c, "bb"c, "src-io"c);
  cat.DcAddDep(b, "std/core"c, ">=2.0.0"c);
  cat.DcAddPkg("std/core"c, "2.1.0"c, "cc"c, "src-core"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  r.RsAddRoot("net/http"c, "^1.0.0"c);
  var rc: int64 := r.RsResolve();

  ok("aufgeloest"c, rc == RS_OK);
  ok("drei Pakete"c, r.RsCount() == 3);
  // Installationsreihenfolge: Abhaengigkeiten zuerst
  okStr("Reihenfolge 0"c, r.RsName(0), "std/core"c);
  okStr("Reihenfolge 1"c, r.RsName(1), "std/io"c);
  okStr("Reihenfolge 2"c, r.RsName(2), "net/http"c);

  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;
}

// ---------------------------------------------------------------------------
// 2. Hoechste passende Version gewinnt
// ---------------------------------------------------------------------------

fn testHighest(): void {
  outLn("hoechste passende Version"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();
  cat.DcAddPkg("buffer"c, "2.0.0"c, "x"c, "s"c);
  cat.DcAddPkg("buffer"c, "2.3.1"c, "x"c, "s"c);
  cat.DcAddPkg("buffer"c, "3.0.0"c, "x"c, "s"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  r.RsAddRoot("buffer"c, "^2.0.0"c);
  var rc: int64 := r.RsResolve();

  ok("aufgeloest"c, rc == RS_OK);
  okStr("waehlt 2.3.1 statt 3.0.0"c, r.RsVer(0), "2.3.1"c);

  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;
}

// ---------------------------------------------------------------------------
// 3. Vertraeglicher Diamant: A->C@^1.0.0, B->C@^1.2.0  =>  C@1.4.0
// ---------------------------------------------------------------------------

fn testDiamondOk(): void {
  outLn("vertraeglicher Diamant"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();

  var a: int64 := cat.DcAddPkg("A"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(a, "C"c, "^1.0.0"c);
  var b: int64 := cat.DcAddPkg("B"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(b, "C"c, "^1.2.0"c);
  cat.DcAddPkg("C"c, "1.1.0"c, "x"c, "s"c);
  cat.DcAddPkg("C"c, "1.4.0"c, "x"c, "s"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  r.RsAddRoot("A"c, "^1.0.0"c);
  r.RsAddRoot("B"c, "^1.0.0"c);
  var rc: int64 := r.RsResolve();

  ok("aufgeloest"c, rc == RS_OK);
  ok("drei Pakete"c, r.RsCount() == 3);
  okStr("C zuerst"c, r.RsName(0), "C"c);
  okStr("C@1.4.0 erfuellt beide"c, r.RsVer(0), "1.4.0"c);

  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;
}

// ---------------------------------------------------------------------------
// 4. Diamant-Konflikt: A->C@^1, B->C@^2  =>  Fehler mit beiden Constraints
// ---------------------------------------------------------------------------

fn testDiamondConflict(): void {
  outLn("Diamant-Konflikt"c);
  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();

  var a: int64 := cat.DcAddPkg("A"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(a, "C"c, "^1.0.0"c);
  var b: int64 := cat.DcAddPkg("B"c, "1.0.0"c, "x"c, "s"c);
  cat.DcAddDep(b, "C"c, "^2.0.0"c);
  cat.DcAddPkg("C"c, "1.4.0"c, "x"c, "s"c);
  cat.DcAddPkg("C"c, "2.0.0"c, "x"c, "s"c);

  var r: Resolver := new Resolver();
  r.RsInit(cat);
  r.RsAddRoot("A"c, "^1.0.0"c);
  r.RsAddRoot("B"c, "^1.0.0"c);
  var rc: int64 := r.RsResolve();

  ok("meldet Konflikt"c, rc == RS_ERR_CONFLICT);
  okStr("nennt das Paket"c, r.RsErrPkg(), "C"c);
  okStr("nennt Constraint A"c, r.RsErrConsA(), "^1.0.0"c);
  okStr("nennt Constraint B"c, r.RsErrConsB(), "^2.0.0"c);

  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;
}

