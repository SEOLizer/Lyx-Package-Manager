// tests/credentials_test.lyx
// WP-PM-08: Tests fuer die Token-Ablage.
//
// Gearbeitet wird mit einem eigenen HOME unterhalb von tests-tmp-cred/, damit
// die Suite niemals die echten ~/.lpm/credentials des Ausfuehrenden anfasst —
// ein Test, der Zugangsdaten ueberschreibt, waere schlimmer als kein Test.
// Kein Netz.
//
// Die Token in dieser Datei sind erfundene Zeichenketten und keine Geheimnisse.
//
// Bauen und ausfuehren:  make test

@description("lpm credentials tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write, fs.create, fs.delete, fs.meta, fs.perm, system.time, system.exit])
unit main;

import std.io grant [fs.read, fs.write];
import std.fs grant [fs.read, fs.write, fs.create, fs.delete, fs.meta, fs.perm, system.time];
import lpm.core.credentials grant [fs.read, fs.write, fs.create, fs.delete, fs.meta, fs.perm];

con HOME:  pchar := "tests-tmp-cred"c;
con CREDS: pchar := "tests-tmp-cred/.lpm/credentials"c;

con REG_A: pchar := "https://lpm.seolizer.de"c;
con REG_B: pchar := "https://andere.example"c;

var tsPass: int64 := 0;
var tsFail: int64 := 0;

fn out(s: pchar): void {
  if s == 0 as pchar { sys_write(1, "(null)"c as int64, 6); return; }
  sys_write(1, s as int64, StrLen(s));
}
fn outLn(s: pchar): void { out(s); sys_write(1, "\n"c as int64, 1); }

fn ok(name: pchar, cond: bool): void {
  if cond {
    tsPass := tsPass + 1;
    out("  ok   "c); outLn(name);
  } else {
    tsFail := tsFail + 1;
    out("  FAIL "c); outLn(name);
  }
}

fn okStr(name: pchar, got: pchar, want: pchar): void {
  var same: bool := false;
  if got != 0 as pchar {
    if StrCmp(got, want) == 0 { same := true; }
  }
  if same {
    tsPass := tsPass + 1;
    out("  ok   "c); outLn(name);
  } else {
    tsFail := tsFail + 1;
    out("  FAIL "c); out(name); out("  erwartet="c); out(want);
    out(" bekommen="c); outLn(got);
  }
}

fn okInt(name: pchar, got: int64, want: int64): void {
  if got == want {
    tsPass := tsPass + 1;
    out("  ok   "c); outLn(name);
  } else {
    tsFail := tsFail + 1;
    out("  FAIL "c); out(name); out("  erwartet="c); PrintInt(want);
    out(" bekommen="c); PrintInt(got); outLn(""c);
  }
}

fn cleanup(): void {
  DeleteFile(CREDS);
  Rmdir("tests-tmp-cred/.lpm/tmp"c);
  Rmdir("tests-tmp-cred/.lpm/registry"c);
  Rmdir("tests-tmp-cred/.lpm/cache"c);
  Rmdir("tests-tmp-cred/.lpm"c);
  Rmdir(HOME);
}

// ---------------------------------------------------------------------------

fn testEmpty(): void {
  outLn("ohne Datei"c);
  var tok: int64 := alloc(CR_TOKEN_MAX);
  ok("nichts zu laden"c, !CrLoad(HOME, REG_A, tok));
  okStr("Puffer bleibt leer"c, tok as pchar, ""c);
  // Vergessen, was es nicht gibt, ist kein Fehler — sonst muesste jeder
  // Aufrufer vorher pruefen, ob er ueberhaupt angemeldet war.
  ok("logout ohne Anmeldung"c, CrForget(HOME, REG_A));
  free(tok, CR_TOKEN_MAX);
}

fn testStoreLoad(): void {
  outLn("speichern und lesen"c);
  Mkdir(HOME, 493);

  ok("speichern gelingt"c, CrStore(HOME, REG_A, "token-aaa"c));
  ok("Datei liegt da"c, FileExists(CREDS));

  var tok: int64 := alloc(CR_TOKEN_MAX);
  ok("wiederfinden"c, CrLoad(HOME, REG_A, tok));
  okStr("gleicher Token"c, tok as pchar, "token-aaa"c);

  // 0600: ein Token, den jeder auf dem Rechner lesen kann, ist keiner.
  okInt("Modus ist 0600"c, FilePerm(CREDS), 384);

  free(tok, CR_TOKEN_MAX);
}

fn testTwoRegistries(): void {
  outLn("mehrere Registries"c);
  ok("zweite speichern"c, CrStore(HOME, REG_B, "token-bbb"c));

  var a: int64 := alloc(CR_TOKEN_MAX);
  var b: int64 := alloc(CR_TOKEN_MAX);
  ok("erste noch da"c,  CrLoad(HOME, REG_A, a));
  okStr("erster Token unveraendert"c, a as pchar, "token-aaa"c);
  ok("zweite lesbar"c,  CrLoad(HOME, REG_B, b));
  okStr("zweiter Token"c, b as pchar, "token-bbb"c);

  // Eine Registry, zu der nichts gespeichert ist, darf nicht versehentlich den
  // Token einer anderen liefern.
  var c: int64 := alloc(CR_TOKEN_MAX);
  ok("unbekannte Registry"c, !CrLoad(HOME, "https://dritte.example"c, c));
  free(c, CR_TOKEN_MAX);
  free(b, CR_TOKEN_MAX);
  free(a, CR_TOKEN_MAX);
}

fn testReplace(): void {
  outLn("ersetzen"c);
  ok("erneut anmelden"c, CrStore(HOME, REG_A, "token-neu"c));

  var a: int64 := alloc(CR_TOKEN_MAX);
  CrLoad(HOME, REG_A, a);
  okStr("neuer Token gilt"c, a as pchar, "token-neu"c);

  // Der alte Eintrag darf nicht als zweite Zeile stehenbleiben, sonst haengt
  // es von der Lesereihenfolge ab, welcher Token gilt.
  var size: int64 := FileSize(CREDS);
  var buf: int64 := alloc(size + 1);
  var got: int64 := ReadFile(CREDS, buf as pchar, size);
  poke8(buf + got, 0);
  var lines: int64 := 0;
  var i: int64 := 0;
  while i < got {
    if peek8(buf + i) as int64 == 10 { lines := lines + 1; }
    i := i + 1;
  }
  okInt("weiterhin zwei Zeilen"c, lines, 2);

  var stale: bool := false;
  i := 0;
  while i + 8 < got {
    if peek8(buf + i) as int64 == 116 {          // 't'
      if StrCmp((buf + i) as pchar, "token-aaa"c) == 0 { stale := true; }
    }
    i := i + 1;
  }
  ok("alter Token ist weg"c, !stale);

  free(buf, size + 1);
  free(a, CR_TOKEN_MAX);
}

fn testForget(): void {
  outLn("abmelden"c);
  ok("vergessen gelingt"c, CrForget(HOME, REG_A));

  var a: int64 := alloc(CR_TOKEN_MAX);
  ok("erste ist weg"c, !CrLoad(HOME, REG_A, a));

  // Abmelden von einer Registry darf die andere nicht mitnehmen.
  var b: int64 := alloc(CR_TOKEN_MAX);
  ok("zweite unberuehrt"c, CrLoad(HOME, REG_B, b));
  okStr("zweiter Token unveraendert"c, b as pchar, "token-bbb"c);

  ok("auch die zweite vergessen"c, CrForget(HOME, REG_B));
  ok("nichts mehr da"c, !CrLoad(HOME, REG_B, b));
  // Die letzte Zeile weg heisst: Datei weg, kein leerer Rest.
  ok("Datei ist geloescht"c, !FileExists(CREDS));

  free(b, CR_TOKEN_MAX);
  free(a, CR_TOKEN_MAX);
}

fn testLongToken(): void {
  outLn("Grenzfaelle"c);

  // 64 Hexzeichen — die Laenge, die der Server ausstellt.
  var real: pchar := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"c;
  ok("64-Zeichen-Token"c, CrStore(HOME, REG_A, real));
  var t: int64 := alloc(CR_TOKEN_MAX);
  CrLoad(HOME, REG_A, t);
  okStr("unveraendert gelesen"c, t as pchar, real);
  free(t, CR_TOKEN_MAX);

  CrForget(HOME, REG_A);
}

// ---------------------------------------------------------------------------

pub fn main(argc: int64, argv: pchar): int64 {
  outLn("credentials tests"c);
  outLn(""c);

  cleanup();     // Reste eines abgebrochenen Laufs

  testEmpty();
  testStoreLoad();
  testTwoRegistries();
  testReplace();
  testForget();
  testLongToken();

  cleanup();
  ok("Testverzeichnis aufgeraeumt"c, !IsDirectory(HOME));

  outLn(""c);
  out("bestanden: "c); PrintInt(tsPass);
  out("   fehlgeschlagen: "c); PrintInt(tsFail);
  outLn(""c);

  if tsFail > 0 { return 1; }
  return 0;
}
