// ---------------------------------------------------------------------------
// lpm cache add <archiv.lxpkg> <name> <version> [--sha256=<hex>]
// Installiert ein lokal vorliegendes .lxpkg in den Cache. Damit ist der
// Install-Pfad ohne Netzwerk testbar (Akzeptanzkriterium WP-PM-03).
// ---------------------------------------------------------------------------

fn lpmCacheAdd(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var archive: pchar := ctx.LcSubArg(1);
  var name:    pchar := ctx.LcSubArg(2);
  var version: pchar := ctx.LcSubArg(3);

  if archive == 0 as pchar {
    cmdErr("Verwendung: lpm cache add <archiv.lxpkg> <name> <version>"c);
    return 1;
  }
  if name == 0 as pchar {
    cmdErr("Verwendung: lpm cache add <archiv.lxpkg> <name> <version>"c);
    return 1;
  }
  if version == 0 as pchar {
    cmdErr("Verwendung: lpm cache add <archiv.lxpkg> <name> <version>"c);
    return 1;
  }
  if FileExists(archive) == false {
    cmdErr("Archiv nicht gefunden."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  LpmCacheEnsure(home);
  var dest: pchar := LpmCachePkgPath(home, name, version);

  var expect: pchar := ctx.LcFlagVal("--sha256"c);
  var rc: int64 := 0;
  if expect == 0 as pchar {
    rc := LpmUnpackLxpkg(archive, dest);
  } else {
    rc := LpmUnpackLxpkgVerified(archive, dest, expect);
  }

  if rc < 0 {
    cmdErr(LpmArchiveErrStr(rc));
    LpmCacheFreePath(dest);
    return 1;
  }

  cmdOut("lpm: "c);
  cmdOut(name);
  cmdOut("@"c);
  cmdOut(version);
  cmdOut(" entpackt nach "c);
  cmdOutLn(dest);
  LpmCacheFreePath(dest);
  return 0;
}

// ---------------------------------------------------------------------------
// WP-PM-06: Install-Flow
//
// Manifest -> Katalog -> Resolver -> lyx.lock. Der Katalog kommt aus dem
// lokalen Cache und dem gespiegelten Registry-Index. Fehlt ein Paket im
// Katalog, holt WP-PM-05 (Teil 2) dessen Index per HTTPS nach und die
// Aufloesung laeuft erneut — siehe cmdResolveAndLock. Der Download der
// Archive selbst folgt mit WP-PM-07; was aufgeloest ist, aber nicht im Cache
// liegt, wird bis dahin ausgewiesen.
// ---------------------------------------------------------------------------

con CMD_RES_OK:         int64 := 0;
con CMD_RES_FAIL:       int64 := 1;
con CMD_RES_INCOMPLETE: int64 := 2;

// Obergrenze fuer nachgeladene Indizes je Aufloesung. Die Grenze ist eine
// Reissleine gegen eine Registry, die immer neue Namen nachschiebt, kein
// erwarteter Normalfall.
con CMD_SYNC_MAX:  int64 := 64;
con CMD_NAME_MAX:  int64 := 256;
con CMD_PATH_MAX:  int64 := 4096;
con CMD_JSON_DEPS_MAX: int64 := 3072;   // passt in eine Kopfzeile
con CMD_SNAP_MAX: int64 := 256;         // Lock-Eintraege im Vorher-Schnappschuss

// Steht name schon in der Liste der in diesem Lauf versuchten Indizes?
fn cmdSeenHas(seen: int64, n: int64, name: pchar): bool {
  var i: int64 := 0;
  while i < n {
    if StrCmp((seen + i * CMD_NAME_MAX) as pchar, name) == 0 { return true; }
    i := i + 1;
  }
  return false;
}

// Kopiert name in die Liste. Rueckgabe: neue Anzahl (unveraendert, wenn der
// Name nicht hineinpasst).
fn cmdSeenAdd(seen: int64, n: int64, name: pchar): int64 {
  var slen: int64 := StrLen(name);
  if slen >= CMD_NAME_MAX { return n; }
  memcpy(seen + n * CMD_NAME_MAX, name as int64, slen);
  poke8(seen + n * CMD_NAME_MAX + slen, 0);
  return n + 1;
}

// Holt den Registry-Index eines Pakets nach. Rueckgabe: true, wenn der Spiegel
// danach neu ist und ein weiterer Aufloesungsversuch Sinn hat.
fn cmdSyncIndex(ctx: LpmCtx, home: pchar, name: pchar, force: bool): bool {
  var registry: pchar := ctx.lcRegistry;
  if registry == 0 as pchar { registry := arDefaultRegistry(); }

  if ctx.lcVerbose {
    cmdOut("lpm: hole Index fuer "c); cmdOut(name);
    cmdOut(" von "c); cmdOutLn(registry);
  }

  var rc: int64 := FtSyncPackageIndex(home, registry, name, force);
  if rc == FT_OK { return true; }

  // FT_FRESH und FT_NOT_MOD heissen: der Spiegel gilt weiter. Ein erneuter
  // Aufloesungsversuch faende dieselben Daten vor, deshalb false — der Aufrufer
  // bricht damit die Schleife ab, statt sie leer zu drehen.
  if rc == FT_FRESH  { return false; }
  if rc == FT_NOT_MOD { return false; }

  // FT_ERR_404 heisst schlicht: das Paket gibt es nicht. Das meldet gleich
  // darauf der Resolver mit RS_ERR_MISSING, hier waere es doppelt.
  if rc != FT_ERR_404 {
    cmdOut("lpm: warning: "c); cmdOut(name); cmdOut(": "c);
    cmdOutLn(FtErrStr(rc));
  }
  return false;
}

// Baut den Katalog aus allen lokal verfuegbaren Quellen auf.
fn cmdBuildCatalog(home: pchar, cat: DepCatalog, verbose: bool): void {
  var cacheDir: pchar := LpmCacheDir(home);
  var fromCache: int64 := LcFromCache(cacheDir, cat);
  LpmCacheFreePath(cacheDir);

  var regDir: pchar := LpmCacheRegistryDir(home);
  var fromIndex: int64 := LcFromIndexDir(regDir, cat);
  LpmCacheFreePath(regDir);

  // Beschaedigte Cache-Pakete meldet der Katalogbau; sie sind nicht im Katalog
  // und werden deshalb gleich neu geholt.
  // Nur unter --verbose: die Schleife weiter unten meldet dasselbe noch einmal,
  // dort aber mit Paketname und betroffener Datei.
  var skipped: int64 := LcVerifySkipped();
  if skipped > 0 {
    if verbose {
      cmdOut("lpm: "c); cmdOutInt(skipped);
      cmdOutLn(" Cache-Paket(e) bei der Pruefung uebersprungen."c);
    }
  }

  if verbose {
    cmdOut("lpm: Katalog: "c); cmdOutInt(fromCache);
    cmdOut(" aus dem Cache, "c); cmdOutInt(fromIndex);
    cmdOutLn(" aus gespiegelten Indizes."c);
  }
}

// WP-PM-07: Holt <name>@<version> aus der Registry und legt es im Cache ab.
//
// Reihenfolge: herunterladen nach ~/.lpm/tmp, SHA256 gegen den Lock-Eintrag
// pruefen, erst dann entpacken. Ein Archiv mit falschem Hash wird geloescht und
// nie ausgepackt — es koennte beliebige Dateien mitbringen.
//
// Rueckgabe: true, wenn das Paket danach im Cache liegt.
fn cmdFetchPkg(ctx: LpmCtx, home: pchar, name: pchar, version: pchar,
               sha256: pchar): bool {
  if sha256 == 0 as pchar { return false; }

  var registry: pchar := ctx.lcRegistry;
  if registry == 0 as pchar { registry := arDefaultRegistry(); }

  cmdOut("lpm: hole "c); cmdOut(name); cmdOut("@"c); cmdOut(version);
  cmdOut(" von "c); cmdOutLn(registry);

  var slot: int64 := alloc(8);
  var rc: int64 := FtDownloadArchive(home, registry, name, version, slot);
  var arch: int64 := peek64(slot);
  free(slot, 8);

  if rc != FT_OK {
    cmdOut("lpm: warning: "c); cmdOut(name); cmdOut("@"c); cmdOut(version);
    cmdOut(": "c); cmdOutLn(FtErrStr(rc));
    return false;
  }

  var dest: pchar := LpmCachePkgPath(home, name, version);
  var urc: int64 := LpmUnpackLxpkgVerified(arch as pchar, dest, sha256);

  DeleteFile(arch as pchar);
  FtFreePath(arch);

  if urc < 0 {
    // Das Zielverzeichnis wird vom Entpacker angelegt, bevor die erste Datei
    // geschrieben ist. Bleibt es nach einem Fehler stehen, haelt LpmCacheHas
    // das Paket beim naechsten Lauf faelschlich fuer installiert.
    LpmCacheDropPkg(home, name, version);

    cmdOut("lpm: error: "c); cmdOut(name); cmdOut("@"c); cmdOut(version);
    cmdOut(": "c); cmdOutLn(LpmArchiveErrStr(urc));
    if urc == LPA_ERR_HASH {
      cmdOutLn("     Der Lock-Eintrag hat Vorrang — die Registry liefert etwas anderes."c);
    }
    LpmCacheFreePath(dest);
    return false;
  }

  if ctx.lcVerbose {
    cmdOut("lpm: "c); cmdOut(name); cmdOut("@"c); cmdOut(version);
    cmdOut(" entpackt ("c); cmdOutInt(urc); cmdOutLn(" Datei(en))."c);
  }
  LpmCacheFreePath(dest);
  return true;
}

// Ist das gecachte Paket noch das, was einmal entpackt wurde?
//
// Geprueft wird gegen das FILES.sha256 im Paket selbst. Der sha256 in lyx.lock
// deckt nur den Weg vom Server bis in den Cache ab — danach sah bisher niemand
// mehr hin, und eine im Cache geaenderte Datei wurde stillschweigend benutzt.
//
// Bei einer Abweichung wird das Paket verworfen und neu geholt: der Anwender
// soll nicht zwischen "reparieren" und "weitermachen" waehlen muessen, wenn
// die Registry die richtige Fassung ohnehin bereithaelt. Mit --offline geht das
// nicht, dann bleibt nur die Meldung.
//
// Rueckgabe: true, wenn das Paket unveraendert im Cache liegt.
fn cmdVerifyCached(ctx: LpmCtx, home: pchar, name: pchar, version: pchar): bool {
  var dir: pchar := LpmCachePkgPath(home, name, version);
  var rc: int64 := LpmVerifyPackage(dir);
  LpmCacheFreePath(dir);

  if rc == LPA_VERIFY_OK { return true; }

  // Pakete aus der Zeit vor `lpm pack` haben keine Liste. Das ist kein Grund,
  // sie abzulehnen — nur einer, es unter --verbose zu erwaehnen.
  if rc == LPA_VERIFY_NOLIST {
    if ctx.lcVerbose {
      cmdOut("lpm: "c); cmdOut(name); cmdOut("@"c); cmdOut(version);
      cmdOutLn(": kein FILES.sha256, Integritaet nicht pruefbar."c);
    }
    return true;
  }

  cmdOut("lpm: warning: "c); cmdOut(name); cmdOut("@"c); cmdOut(version);
  cmdOut(": "c); cmdOut(LpmVerifyErrStr(rc));
  var bad: pchar := LpaVerifyBadFile();
  if bad != 0 as pchar {
    if peek8(bad as int64) as int64 != 0 {
      cmdOut(" ("c); cmdOut(bad); cmdOut(")"c);
    }
  }
  cmdOutLn(""c);

  if ctx.lcOffline {
    cmdOutLn("     --offline ist gesetzt — das Paket wird nicht neu geholt."c);
    return false;
  }

  // Verworfen wird das Verzeichnis vollstaendig; ein halb ersetztes Paket
  // waere schlimmer als das veraenderte.
  cmdOutLn("     wird verworfen und neu geholt."c);
  LpmCacheDropPkg(home, name, version);
  return false;
}

// Traegt alle Dependencies des Manifests als Wurzeln ein.
fn cmdAddRoots(mf: Manifest, r: Resolver): void {
  var i: int64 := 0;
  while i < mf.MfDepCount() {
    r.RsAddRoot(mf.MfDepName(i), mf.MfDepVer(i));
    i := i + 1;
  }
}

// Gibt einen Resolver-Fehler mit Kontext aus.
fn cmdResolveErr(r: Resolver, rc: int64): void {
  cmdOut("lpm: error: "c);
  cmdOut(r.RsErrStr(rc));
  var pkg: pchar := r.RsErrPkg();
  if pkg != 0 as pchar {
    cmdOut(" — "c);
    cmdOut(pkg);
  }
  var a: pchar := r.RsErrConsA();
  var b: pchar := r.RsErrConsB();
  if a != 0 as pchar {
    if b != 0 as pchar {
      cmdOut(" ("c); cmdOut(a); cmdOut(" gegen "c); cmdOut(b); cmdOut(")"c);
    } else {
      cmdOut(" ("c); cmdOut(a); cmdOut(")"c);
    }
  }
  cmdOutLn(""c);
}

// Erfuellt das vorhandene lyx.lock bereits alle Manifest-Constraints?
// Dann wird nicht neu aufgeloest — zweites `lpm install` ohne Aenderung soll
// nichts tun (Akzeptanzkriterium WP-PM-06).
fn cmdLockSatisfies(mf: Manifest, lock: LockFile): bool {
  var i: int64 := 0;
  while i < mf.MfDepCount() {
    var idx: int64 := lock.LfFind(mf.MfDepName(i));
    if idx < 0 { return false; }
    var v: SemVer := new SemVer();
    v.SvParse(lock.LfGetVer(idx));
    var ok: bool := false;
    if v.svValid {
      if v.SvSatisfies(mf.MfDepVer(i)) { ok := true; }
    }
    dispose v;
    if !ok { return false; }
    i := i + 1;
  }
  return true;
}

// Loest auf und schreibt lyx.lock.
// Rueckgabe: CMD_RES_OK, CMD_RES_FAIL (Aufloesung gescheitert) oder
// CMD_RES_INCOMPLETE (aufgeloest, aber nicht alles liegt lokal vor).
// Der Aufrufer muss die Faelle unterscheiden: bei CMD_RES_FAIL darf lyx.toml
// nicht veraendert werden, sonst bleibt ein unaufloesbares Paket darin stehen.
fn cmdResolveAndLock(ctx: LpmCtx, home: pchar, mf: Manifest): int64 {
  // Aufloesen, und bei einem unbekannten Paket dessen Index nachladen und noch
  // einmal aufloesen. Transitive Dependencies tauchen erst auf, wenn der Index
  // ihres Elternpakets gelesen ist — deshalb die Schleife statt eines einzelnen
  // Vorab-Downloads der Manifest-Wurzeln.
  var seen: int64 := alloc(CMD_SYNC_MAX * CMD_NAME_MAX);
  var seenN: int64 := 0;

  var cat: DepCatalog := 0 as DepCatalog;
  var r: Resolver := 0 as Resolver;
  var rc: int64 := 0;

  while true {
    cat := new DepCatalog();
    cat.DcInit();
    cmdBuildCatalog(home, cat, ctx.lcVerbose);

    r := new Resolver();
    r.RsInit(cat);
    cmdAddRoots(mf, r);

    rc := r.RsResolve();
    if rc != RS_ERR_MISSING { break; }
    if ctx.lcOffline { break; }
    if seenN >= CMD_SYNC_MAX { break; }

    var miss: pchar := r.RsErrPkg();
    if miss == 0 as pchar { break; }
    if cmdSeenHas(seen, seenN, miss) { break; }

    // Namen sichern, bevor der Resolver freigegeben wird — miss zeigt in ihn.
    var before: int64 := seenN;
    seenN := cmdSeenAdd(seen, seenN, miss);
    if seenN == before { break; }
    var name: pchar := (seen + before * CMD_NAME_MAX) as pchar;

    // Erst holen, dann freigeben: bringt der Download nichts Neues, bleibt das
    // vorhandene Ergebnis samt Fehlerkontext stehen und wird gemeldet.
    if !cmdSyncIndex(ctx, home, name, false) { break; }

    r.RsFree(); dispose r;
    cat.DcFree(); dispose cat;
  }

  free(seen, CMD_SYNC_MAX * CMD_NAME_MAX);

  if rc != RS_OK {
    cmdResolveErr(r, rc);
    // Ohne diesen Hinweis liest sich RS_ERR_MISSING wie eine Aussage ueber die
    // Registry, obwohl mit --offline nur der lokale Spiegel befragt wurde.
    if rc == RS_ERR_MISSING {
      if ctx.lcOffline {
        cmdOutLn("     --offline ist gesetzt — gesucht wurde nur im lokalen Spiegel."c);
      }
    }
    r.RsFree(); dispose r;
    cat.DcFree(); dispose cat;
    return CMD_RES_FAIL;
  }

  var lock: LockFile := new LockFile();
  lock.LfInit();
  r.RsToLock(lock);

  var written: bool := lock.LfWrite("lyx.lock"c);
  if !written { cmdErr("lyx.lock konnte nicht geschrieben werden."c); }

  // Was fehlt noch im Cache? Was fehlt, wird geholt — der sha256 kommt dabei
  // aus dem gerade geschriebenen lyx.lock, nicht aus dem Index: der Lock-Eintrag
  // hat immer Vorrang (docs/registry.md, Abschnitt Integritaet).
  var missing: int64 := 0;
  var n: int64 := 0;
  while n < r.RsCount() {
    var nm: pchar := r.RsName(n);
    var vr: pchar := r.RsVer(n);
    var usable: bool := false;
    if LpmCacheHas(home, nm, vr) {
      usable := cmdVerifyCached(ctx, home, nm, vr);
      if usable {
        if ctx.lcVerbose {
          cmdOut("lpm: "c); cmdOut(nm); cmdOut("@"c); cmdOut(vr);
          cmdOutLn(" liegt im Cache."c);
        }
      }
    }

    if !usable {
      var got: bool := false;
      if !ctx.lcOffline {
        var li: int64 := lock.LfFind(nm);
        if li >= 0 { got := cmdFetchPkg(ctx, home, nm, vr, lock.LfGetSha256(li)); }
      }
      if !got {
        missing := missing + 1;
        cmdOut("lpm: fehlt im Cache: "c); cmdOut(nm); cmdOut("@"c); cmdOutLn(vr);
      }
    }
    n := n + 1;
  }

  cmdOut("lpm: "c); cmdOutInt(r.RsCount());
  cmdOutLn(" Paket(e) aufgeloest, lyx.lock geschrieben."c);

  if missing > 0 {
    cmdOut("lpm: "c); cmdOutInt(missing);
    cmdOutLn(" Paket(e) fehlen lokal und liessen sich nicht holen."c);
    cmdOutLn("     Hilft auch: lpm cache add <archiv.lxpkg> <name> <version>"c);
  }

  lock.LfFree(); dispose lock;
  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;

  if !written { return CMD_RES_FAIL; }
  if missing > 0 { return CMD_RES_INCOMPLETE; }
  return CMD_RES_OK;
}

// Liest lyx.toml, legt es an wenn es fehlt.
fn cmdLoadManifest(mf: Manifest): bool {
  if FileExists("lyx.toml"c) { return mf.MfRead("lyx.toml"c); }
  return false;
}

// Trennt "name@constraint" auf. Gibt das Constraint zurueck (Zeiger in einen
// eigenen Puffer) und kuerzt name in place. Ohne '@' wird "latest" geliefert.
fn cmdSplitSpec(spec: pchar, nameOut: int64, cap: int64): pchar {
  var slen: int64 := StrLen(spec);
  var at: int64 := 0 - 1;
  var i: int64 := 0;
  while i < slen {
    if peek8(spec as int64 + i) as int64 == 64 { at := i; }
    i := i + 1;
  }
  if at < 0 {
    if slen >= cap { return 0 as pchar; }
    memcpy(nameOut, spec as int64, slen);
    poke8(nameOut + slen, 0);
    return "latest"c;
  }
  if at >= cap { return 0 as pchar; }
  memcpy(nameOut, spec as int64, at);
  poke8(nameOut + at, 0);
  return (spec as int64 + at + 1) as pchar;
}

fn lpmInstall(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var home: pchar := cmdGetHome(argc, argv);
  var mf: Manifest := new Manifest();
  mf.MfInit();

  var haveToml: bool := cmdLoadManifest(mf);
  var spec: pchar := ctx.LcSubArg(0);

  if !haveToml {
    if spec == 0 as pchar {
      cmdErr("Kein lyx.toml in diesem Verzeichnis. Erst 'lpm init' ausfuehren."c);
      mf.MfFree(); dispose mf;
      return 1;
    }
    // `lpm install <pkg>` in leerem Verzeichnis legt das Manifest an.
    mf.MfAddDep("__placeholder__"c, "*"c);
    mf.MfRemoveDep("__placeholder__"c);
  }

  if spec != 0 as pchar {
    var nameBuf: int64 := alloc(512);
    var cons: pchar := cmdSplitSpec(spec, nameBuf, 512);
    if cons == 0 as pchar {
      cmdErr("Paketname zu lang."c);
      free(nameBuf, 512);
      mf.MfFree(); dispose mf;
      return 1;
    }
    // Nur im Speicher — geschrieben wird erst, wenn die Aufloesung haelt.
    mf.MfSetDep(nameBuf as pchar, cons);
    free(nameBuf, 512);
  }

  if mf.MfDepCount() == 0 {
    cmdOutLn("lpm: keine Dependencies in lyx.toml — nichts zu tun."c);
    mf.MfFree(); dispose mf;
    return 0;
  }

  // Bereits geloestes Lock-File nicht neu berechnen.
  if spec == 0 as pchar {
    if FileExists("lyx.lock"c) {
      var lock: LockFile := new LockFile();
      lock.LfInit();
      if lock.LfRead("lyx.lock"c) {
        if cmdLockSatisfies(mf, lock) {
          cmdOutLn("lpm: lyx.lock ist aktuell — nichts zu tun."c);
          lock.LfFree(); dispose lock;
          mf.MfFree(); dispose mf;
          return 0;
        }
      }
      lock.LfFree(); dispose lock;
    }
  }

  var rc: int64 := cmdResolveAndLock(ctx, home, mf);

  if rc == CMD_RES_FAIL {
    if spec != 0 as pchar {
      cmdOutLn("lpm: lyx.toml bleibt unveraendert."c);
    }
    mf.MfFree(); dispose mf;
    return 1;
  }

  if spec != 0 as pchar {
    if !mf.MfWrite("lyx.toml"c) {
      cmdErr("lyx.toml konnte nicht geschrieben werden."c);
      mf.MfFree(); dispose mf;
      return 1;
    }
  }

  mf.MfFree(); dispose mf;
  if rc == CMD_RES_INCOMPLETE { return 1; }
  return 0;
}

fn lpmRemove(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var name: pchar := ctx.LcSubArg(0);
  if name == 0 as pchar {
    cmdErr("Verwendung: lpm remove <pkg>"c);
    return 1;
  }
  if !FileExists("lyx.toml"c) {
    cmdErr("Kein lyx.toml in diesem Verzeichnis."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  var mf: Manifest := new Manifest();
  mf.MfInit();
  if !mf.MfRead("lyx.toml"c) {
    cmdErr("lyx.toml konnte nicht gelesen werden."c);
    mf.MfFree(); dispose mf;
    return 1;
  }

  if !mf.MfRemoveDep(name) {
    cmdOut("lpm: '"c); cmdOut(name);
    cmdOutLn("' steht nicht in lyx.toml."c);
    mf.MfFree(); dispose mf;
    return 1;
  }

  if !mf.MfWrite("lyx.toml"c) {
    cmdErr("lyx.toml konnte nicht geschrieben werden."c);
    mf.MfFree(); dispose mf;
    return 1;
  }
  cmdOut("lpm: '"c); cmdOut(name); cmdOutLn("' aus lyx.toml entfernt."c);

  if mf.MfDepCount() == 0 {
    // Ohne Dependencies ist auch das Lock leer.
    var empty: LockFile := new LockFile();
    empty.LfInit();
    empty.LfWrite("lyx.lock"c);
    empty.LfFree(); dispose empty;
    cmdOutLn("lpm: lyx.lock geleert."c);
    mf.MfFree(); dispose mf;
    return 0;
  }

  var rc: int64 := cmdResolveAndLock(ctx, home, mf);
  if rc == CMD_RES_FAIL {
    cmdOutLn("lpm: lyx.toml ist aktualisiert, lyx.lock aber unveraendert."c);
  }
  mf.MfFree(); dispose mf;
  if rc == CMD_RES_OK { return 0; }
  return 1;
}

fn lpmList(argc: int64, argv: pchar): int64 {
  if !FileExists("lyx.lock"c) {
    cmdOutLn("lpm: kein lyx.lock — erst 'lpm install' ausfuehren."c);
    return 1;
  }
  var home: pchar := cmdGetHome(argc, argv);
  var lock: LockFile := new LockFile();
  lock.LfInit();
  if !lock.LfRead("lyx.lock"c) {
    cmdErr("lyx.lock konnte nicht gelesen werden."c);
    lock.LfFree(); dispose lock;
    return 1;
  }

  cmdOutLn("Aufgeloeste Pakete (lyx.lock):"c);
  var i: int64 := 0;
  var count: int64 := 0;
  while true {
    var nm: pchar := lock.LfGetName(i);
    if nm == 0 as pchar { break; }
    var vr: pchar := lock.LfGetVer(i);
    cmdOut("  "c); cmdOut(nm); cmdOut("@"c); cmdOut(vr);
    if LpmCacheHas(home, nm, vr) { cmdOutLn(""c); }
    else { cmdOutLn("   (nicht im Cache)"c); }
    count := count + 1;
    i := i + 1;
  }
  if count == 0 { cmdOutLn("  (keine)"c); }

  lock.LfFree(); dispose lock;
  return 0;
}

// ---------------------------------------------------------------------------
// update — Registry-Spiegel auffrischen
// ---------------------------------------------------------------------------
//
// Holt /index.json in den lokalen Spiegel. Die Paket-Indizes kommen weiterhin
// bedarfsgetrieben beim Aufloesen (siehe cmdResolveAndLock); `update` ist der
// Weg, den Gesamtindex fuer `lpm search` (WP-PM-09) frisch zu bekommen.
// Merkt sich die Versionen aus lyx.lock, um nach der Aufloesung sagen zu
// koennen, was sich geaendert hat. Rueckgabe: Anzahl der Eintraege.
fn cmdSnapshotLock(names: int64, vers: int64, max: int64): int64 {
  if !FileExists("lyx.lock"c) { return 0; }

  var lock: LockFile := new LockFile();
  lock.LfInit();
  var n: int64 := 0;
  if lock.LfRead("lyx.lock"c) {
    var i: int64 := 0;
    while i < max {
      var nm: pchar := lock.LfGetName(i);
      if nm == 0 as pchar { break; }
      var vr: pchar := lock.LfGetVer(i);

      var nb: int64 := alloc(CMD_NAME_MAX);
      var vb: int64 := alloc(CMD_NAME_MAX);
      memcpy(nb, nm as int64, StrLen(nm)); poke8(nb + StrLen(nm), 0);
      memcpy(vb, vr as int64, StrLen(vr)); poke8(vb + StrLen(vr), 0);
      poke64(names + n * 8, nb);
      poke64(vers  + n * 8, vb);
      n := n + 1;
      i := i + 1;
    }
  }
  lock.LfFree(); dispose lock;
  return n;
}

fn cmdFreeSnapshot(names: int64, vers: int64, n: int64): void {
  var i: int64 := 0;
  while i < n {
    free(peek64(names + i * 8), CMD_NAME_MAX);
    free(peek64(vers  + i * 8), CMD_NAME_MAX);
    i := i + 1;
  }
}

// Version eines Pakets im Schnappschuss, oder 0.
fn cmdSnapVer(names: int64, vers: int64, n: int64, name: pchar): pchar {
  var i: int64 := 0;
  while i < n {
    if StrCmp(peek64(names + i * 8) as pchar, name) == 0 {
      return peek64(vers + i * 8) as pchar;
    }
    i := i + 1;
  }
  return 0 as pchar;
}

// Vergleicht den Schnappschuss mit dem neuen lyx.lock und gibt die Aenderungen
// aus. Rueckgabe: Anzahl geaenderter Pakete.
fn cmdReportChanges(names: int64, vers: int64, n: int64): int64 {
  var lock: LockFile := new LockFile();
  lock.LfInit();
  if !lock.LfRead("lyx.lock"c) {
    lock.LfFree(); dispose lock;
    return 0;
  }

  var changed: int64 := 0;
  var i: int64 := 0;
  while true {
    var nm: pchar := lock.LfGetName(i);
    if nm == 0 as pchar { break; }
    var neu: pchar := lock.LfGetVer(i);
    var alt: pchar := cmdSnapVer(names, vers, n, nm);

    if alt == 0 as pchar {
      cmdOut("  + "c); cmdOut(nm); cmdOut(" "c); cmdOutLn(neu);
      changed := changed + 1;
    } else if StrCmp(alt, neu) != 0 {
      cmdOut("  ~ "c); cmdOut(nm); cmdOut(" "c); cmdOut(alt);
      cmdOut(" -> "c); cmdOutLn(neu);
      changed := changed + 1;
    }
    i := i + 1;
  }

  // Was im Schnappschuss stand und jetzt fehlt, ist weggefallen — etwa weil
  // eine neue Version des Elternpakets die Abhaengigkeit nicht mehr hat.
  var j: int64 := 0;
  while j < n {
    var oldName: pchar := peek64(names + j * 8) as pchar;
    if lock.LfFind(oldName) < 0 {
      cmdOut("  - "c); cmdOut(oldName); cmdOut(" "c);
      cmdOutLn(peek64(vers + j * 8) as pchar);
      changed := changed + 1;
    }
    j := j + 1;
  }

  lock.LfFree(); dispose lock;
  return changed;
}

// ---------------------------------------------------------------------------
// update — Registry-Spiegel auffrischen und Pakete aktualisieren
// ---------------------------------------------------------------------------
//
// `lpm update` frischt zuerst den Index auf und loest dann neu auf, ohne das
// bestehende lyx.lock als gegeben zu nehmen. Innerhalb der Constraints aus
// lyx.toml wird also die jeweils hoechste Version gewaehlt.
//
// Ohne lyx.toml bleibt es beim Auffrischen des Index — dann gibt es nichts
// aufzuloesen.
//
// `lpm update <pkg>` beschraenkt die Bewegung auf ein Paket: alle uebrigen
// Eintraege aus lyx.lock werden als exakte Version festgehalten. Das ist der
// uebliche Fall, wenn man eine einzelne Abhaengigkeit nachziehen will, ohne
// sich den Rest des Graphen zu veraendern.
fn lpmUpdate(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  if ctx.lcOffline {
    cmdErr("update braucht Netzwerk, --offline ist gesetzt."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  if home == 0 as pchar {
    cmdErr("HOME ist nicht gesetzt."c);
    return 1;
  }

  var registry: pchar := ctx.lcRegistry;
  if registry == 0 as pchar { registry := arDefaultRegistry(); }

  // force: ein ausdrueckliches `lpm update` ignoriert die TTL, sonst taete es
  // eine Stunde lang sichtbar nichts.
  var rc: int64 := FtSyncRootIndex(home, registry, true);
  if rc < 0 {
    cmdOut("lpm: error: "c); cmdOut(registry); cmdOut(": "c);
    cmdOutLn(FtErrStr(rc));
    return 1;
  }
  if ctx.lcVerbose {
    cmdOut("lpm: Index von "c); cmdOut(registry);
    if rc == FT_NOT_MOD { cmdOutLn(" ist unveraendert."c); }
    else { cmdOutLn(" aktualisiert."c); }
  }

  var mf: Manifest := new Manifest();
  mf.MfInit();
  if !cmdLoadManifest(mf) {
    mf.MfFree(); dispose mf;
    cmdOut("lpm: Index von "c); cmdOut(registry); cmdOutLn(" aktualisiert."c);
    cmdOutLn("     (kein lyx.toml — nichts aufzuloesen)"c);
    return 0;
  }

  if mf.MfDepCount() == 0 {
    mf.MfFree(); dispose mf;
    cmdOutLn("lpm: keine Dependencies in lyx.toml — nichts zu tun."c);
    return 0;
  }

  // Die Paket-Indizes ebenfalls erzwungen auffrischen. Ohne das saehe der
  // Resolver die Versionsliste von vor der TTL — `update` wuerde melden, alles
  // sei aktuell, waehrend in der Registry laengst eine neue Version liegt.
  var d: int64 := 0;
  while d < mf.MfDepCount() {
    cmdSyncIndex(ctx, home, mf.MfDepName(d), true);
    d := d + 1;
  }

  // Stand vorher festhalten, um hinterher den Unterschied zeigen zu koennen.
  var snapNames: int64 := alloc(CMD_SNAP_MAX * 8);
  var snapVers:  int64 := alloc(CMD_SNAP_MAX * 8);
  var snapN: int64 := cmdSnapshotLock(snapNames, snapVers, CMD_SNAP_MAX);

  // Mit Paketnamen: alles ausser diesem Paket auf der Lock-Version festhalten.
  var only: pchar := ctx.LcSubArg(0);
  if only != 0 as pchar {
    if snapN == 0 {
      cmdErr("kein lyx.lock — erst 'lpm install' ausfuehren."c);
      free(snapNames, CMD_SNAP_MAX * 8);
      free(snapVers,  CMD_SNAP_MAX * 8);
      mf.MfFree(); dispose mf;
      return 1;
    }
    if cmdSnapVer(snapNames, snapVers, snapN, only) == 0 as pchar {
      cmdOut("lpm: error: "c); cmdOut(only);
      cmdOutLn(" steht nicht in lyx.lock."c);
      free(snapNames, CMD_SNAP_MAX * 8);
      free(snapVers,  CMD_SNAP_MAX * 8);
      mf.MfFree(); dispose mf;
      return 1;
    }

    var k: int64 := 0;
    while k < snapN {
      var nm: pchar := peek64(snapNames + k * 8) as pchar;
      if StrCmp(nm, only) != 0 {
        // Als exakte Version eintragen — der Resolver behandelt eine nackte
        // Version als "genau diese".
        mf.MfSetDep(nm, peek64(snapVers + k * 8) as pchar);
      }
      k := k + 1;
    }
  }

  var res: int64 := cmdResolveAndLock(ctx, home, mf);
  mf.MfFree(); dispose mf;

  if res == CMD_RES_FAIL {
    free(snapNames, CMD_SNAP_MAX * 8);
    free(snapVers,  CMD_SNAP_MAX * 8);
    return 1;
  }

  var changed: int64 := cmdReportChanges(snapNames, snapVers, snapN);
  cmdFreeSnapshot(snapNames, snapVers, snapN);
  free(snapNames, CMD_SNAP_MAX * 8);
  free(snapVers,  CMD_SNAP_MAX * 8);

  if changed == 0 {
    cmdOutLn("lpm: alles ist bereits aktuell."c);
  } else {
    cmdOut("lpm: "c); cmdOutInt(changed); cmdOutLn(" Aenderung(en)."c);
  }

  // Das Manifest bleibt unangetastet: `update` bewegt sich innerhalb der dort
  // festgelegten Constraints. Wer die Grenze selbst verschieben will, aendert
  // lyx.toml oder ruft `lpm install <pkg>@<range>`.
  if res == CMD_RES_INCOMPLETE { return 2; }
  return 0;
}

// ---------------------------------------------------------------------------
// search / info — lesen den gespiegelten Gesamtindex
// ---------------------------------------------------------------------------

con CMD_JSON_MAX: int64 := 4194304;

// Liest <regDir>/index.json in einen frisch allozierten Puffer.
// *sizeOut bekommt die Puffergroesse (fuer das spaetere free), Rueckgabe ist
// der Puffer oder 0.
fn cmdReadRootIndex(home: pchar, sizeOut: int64): int64 {
  var regDir: pchar := LpmCacheRegistryDir(home);
  var path: int64 := alloc(CMD_NAME_MAX * 8);
  var p: int64 := 0;
  p := cmdWrS(path, p, regDir);
  p := cmdWrS(path, p, "/index.json"c);
  poke8(path + p, 0);
  LpmCacheFreePath(regDir);

  if !FileExists(path as pchar) { free(path, CMD_NAME_MAX * 8); return 0; }
  var size: int64 := FileSize(path as pchar);
  if size <= 0 { free(path, CMD_NAME_MAX * 8); return 0; }
  if size > CMD_JSON_MAX { free(path, CMD_NAME_MAX * 8); return 0; }

  var buf: int64 := alloc(size + 1);
  var got: int64 := ReadFile(path as pchar, buf as pchar, size);
  free(path, CMD_NAME_MAX * 8);
  if got <= 0 { free(buf, size + 1); return 0; }
  poke8(buf + got, 0);

  poke64(sizeOut, size + 1);
  return buf;
}

// Frischt den Spiegel des Gesamtindex auf, sofern nicht --offline.
// Ein Fehler ist kein Abbruch: ein vorhandener Spiegel ist besser als nichts.
fn cmdRefreshRootIndex(ctx: LpmCtx, home: pchar): void {
  if ctx.lcOffline { return; }
  var registry: pchar := ctx.lcRegistry;
  if registry == 0 as pchar { registry := arDefaultRegistry(); }
  // Kein force: search und info duerfen den Spiegel innerhalb der TTL nutzen,
  // sonst kostet jede Suche einen Roundtrip.
  var rc: int64 := FtSyncRootIndex(home, registry, false);
  if rc < 0 {
    if ctx.lcVerbose {
      cmdOut("lpm: warning: Index nicht aktualisiert: "c);
      cmdOutLn(FtErrStr(rc));
    }
  }
}

// Laedt den Gesamtindex in eine PkgList. Rueckgabe: false, wenn kein
// brauchbarer Spiegel vorliegt (dann ist die Liste unveraendert).
fn cmdLoadRootIndex(ctx: LpmCtx, home: pchar, list: PkgList): bool {
  cmdRefreshRootIndex(ctx, home);

  var sizeBox: int64 := alloc(8);
  poke64(sizeBox, 0);
  var buf: int64 := cmdReadRootIndex(home, sizeBox);
  var size: int64 := peek64(sizeBox);
  free(sizeBox, 8);

  if buf == 0 {
    cmdErr("kein Registry-Index vorhanden — 'lpm update' ausfuehren."c);
    return false;
  }

  var rc: int64 := IxParseRootIndex(buf as pchar, list);
  free(buf, size);

  if rc < 0 {
    cmdErr("Registry-Index ist beschaedigt — 'lpm update' ausfuehren."c);
    return false;
  }
  return true;
}

// Enthaelt hay die Zeichenfolge needle? Kleinschreibung wird vorausgesetzt:
// Paketnamen sind per Konvention klein, und die Suche soll nicht so tun, als
// koennte sie mehr.
fn cmdContains(hay: pchar, needle: pchar): bool {
  if hay == 0 as pchar { return false; }
  var hl: int64 := StrLen(hay);
  var nl: int64 := StrLen(needle);
  if nl == 0 { return true; }
  if nl > hl { return false; }

  var i: int64 := 0;
  while i <= hl - nl {
    var j: int64 := 0;
    var same: bool := true;
    while j < nl {
      if peek8(hay as int64 + i + j) as int64 != peek8(needle as int64 + j) as int64 {
        same := false;
        break;
      }
      j := j + 1;
    }
    if same { return true; }
    i := i + 1;
  }
  return false;
}

fn lpmSearch(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var query: pchar := ctx.LcSubArg(0);
  if query == 0 as pchar {
    cmdErr("search braucht einen Suchbegriff: lpm search <query>"c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  if home == 0 as pchar { cmdErr("HOME ist nicht gesetzt."c); return 1; }

  var list: PkgList := new PkgList();
  list.PlInit();
  if !cmdLoadRootIndex(ctx, home, list) {
    list.PlFree(); dispose list;
    return 1;
  }

  var hits: int64 := 0;
  var i: int64 := 0;
  while i < list.PlCount() {
    var nm: pchar := list.PlName(i);
    if cmdContains(nm, query) || cmdContains(list.PlDesc(i), query) {
      cmdOut("  "c); cmdOut(nm);
      var lat: pchar := list.PlLatest(i);
      if lat != 0 as pchar {
        if peek8(lat as int64) as int64 != 0 { cmdOut("@"c); cmdOut(lat); }
      }
      var ds: pchar := list.PlDesc(i);
      if ds != 0 as pchar {
        if peek8(ds as int64) as int64 != 0 { cmdOut(" — "c); cmdOut(ds); }
      }
      cmdOutLn(""c);
      hits := hits + 1;
    }
    i := i + 1;
  }

  if hits == 0 {
    cmdOut("lpm: nichts gefunden fuer '"c); cmdOut(query); cmdOutLn("'."c);
  } else {
    cmdOut("lpm: "c); cmdOutInt(hits); cmdOutLn(" Treffer."c);
  }

  list.PlFree(); dispose list;
  if hits == 0 { return 1; }
  return 0;
}

fn lpmInfo(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var name: pchar := ctx.LcSubArg(0);
  if name == 0 as pchar {
    cmdErr("info braucht einen Paketnamen: lpm info <pkg>"c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  if home == 0 as pchar { cmdErr("HOME ist nicht gesetzt."c); return 1; }

  // Beschreibung und latest stehen im Gesamtindex, die Versionsliste samt
  // Dependencies nur im Paket-Index — deshalb beide Quellen.
  var list: PkgList := new PkgList();
  list.PlInit();
  var haveRoot: bool := cmdLoadRootIndex(ctx, home, list);

  cmdOut(name); cmdOutLn(""c);

  if haveRoot {
    var idx: int64 := list.PlFind(name);
    if idx >= 0 {
      var ds: pchar := list.PlDesc(idx);
      if ds != 0 as pchar {
        if peek8(ds as int64) as int64 != 0 { cmdOut("  "c); cmdOutLn(ds); }
      }
      var lat: pchar := list.PlLatest(idx);
      if lat != 0 as pchar {
        if peek8(lat as int64) as int64 != 0 {
          cmdOut("  latest: "c); cmdOutLn(lat);
        }
      }
    }
  }
  list.PlFree(); dispose list;

  // Paket-Index holen und ueber den Katalog auswerten.
  if !ctx.lcOffline { cmdSyncIndex(ctx, home, name, false); }

  var cat: DepCatalog := new DepCatalog();
  cat.DcInit();
  var regDir: pchar := LpmCacheRegistryDir(home);
  var n: int64 := LcFromIndexFile(regDir, name, cat);
  LpmCacheFreePath(regDir);

  if n <= 0 {
    cmdOutLn("  (keine Versionen bekannt — Paket nicht in der Registry?)"c);
    cat.DcFree(); dispose cat;
    return 1;
  }

  cmdOutLn("  Versionen:"c);
  var i: int64 := 0;
  var shown: int64 := 0;
  while i < cat.DcCount() {
    if StrCmp(cat.DcName(i), name) == 0 {
      var vr: pchar := cat.DcVer(i);
      cmdOut("    "c); cmdOut(vr);
      if LpmCacheHas(home, name, vr) { cmdOut("   (im Cache)"c); }
      cmdOutLn(""c);
      shown := shown + 1;
    }
    i := i + 1;
  }

  cmdOut("  "c); cmdOutInt(shown); cmdOutLn(" Version(en)."c);
  cat.DcFree(); dispose cat;
  return 0;
}

// ---------------------------------------------------------------------------
// resolve — Auflösungs-Hook für lyxc (WP-PM-07)
// ---------------------------------------------------------------------------
//
// Aufrufvertrag, auf den sich lyxc verlassen darf:
//
//   stdout  bei Erfolg GENAU eine Zeile: der Cache-Pfad des Pakets.
//           Sonst nichts — kein Fortschritt, keine Warnung, keine Leerzeile.
//   stderr  alle Meldungen, auch die von --verbose.
//   Exit 0  Paket liegt im Cache, der Pfad auf stdout ist gültig.
//   Exit 1  nicht auflösbar (unbekannt, Netz weg, Hash falsch, ...).
//
// Diese Trennung ist der ganze Sinn des Befehls: der Compiler liest stdout
// direkt als Pfad. Jede versehentliche Zeile mehr würde ihn in die Irre führen,
// deshalb schreiben die Hilfsfunktionen hier ausschliesslich nach stderr.

// Wie cmdOut/cmdOutLn, aber nach stderr.
fn cmdEOut(s: pchar): void {
  if s == 0 as pchar { return; }
  sys_write(2, s as int64, StrLen(s));
}
fn cmdEOutLn(s: pchar): void {
  cmdEOut(s);
  sys_write(2, "\n"c as int64, 1);
}

// Übersetzt einen Import-Namen in einen Paketnamen.
//
// lyxc sieht `import net.http` und kennt damit Punkte als Trenner; die Registry
// führt `net/http`. Enthält der Name bereits einen Slash, wird er unverändert
// übernommen — dann kommt er aus einem Manifest und ist schon richtig. Sonst
// werden Punkte zu Slashes.
//
// Der Grenzfall ist ein flacher Name mit Punkt (`core.io`): der wird hier zu
// `core/io`. Beides gleichzeitig geht nicht, und die hierarchische Lesart ist
// die, die zur Import-Syntax des Compilers passt.
fn cmdImportToPkg(name: pchar, dst: int64, cap: int64): bool {
  var n: int64 := StrLen(name);
  if n == 0 { return false; }
  if n >= cap { return false; }

  var hasSlash: bool := false;
  var i: int64 := 0;
  while i < n {
    if peek8(name as int64 + i) as int64 == 47 { hasSlash := true; }
    i := i + 1;
  }

  i := 0;
  while i < n {
    var c: int64 := peek8(name as int64 + i) as int64;
    if !hasSlash {
      if c == 46 { c := 47; }
    }
    poke8(dst + i, c as int8);
    i := i + 1;
  }
  poke8(dst + n, 0);
  return true;
}

// Gibt es zu name bereits einen Lock-Eintrag? Dann gilt dessen Version — der
// Compiler soll dasselbe sehen wie ein `lpm install`, nicht die neueste Version.
// Rueckgabe: true, wenn *verOut gefuellt wurde.
fn cmdLockedVersion(name: pchar, verOut: int64, cap: int64): bool {
  if !FileExists("lyx.lock"c) { return false; }

  var lock: LockFile := new LockFile();
  lock.LfInit();
  var found: bool := false;
  if lock.LfRead("lyx.lock"c) {
    var idx: int64 := lock.LfFind(name);
    if idx >= 0 {
      var v: pchar := lock.LfGetVer(idx);
      if v != 0 as pchar {
        var vl: int64 := StrLen(v);
        if vl < cap {
          memcpy(verOut, v as int64, vl);
          poke8(verOut + vl, 0);
          found := true;
        }
      }
    }
  }
  lock.LfFree(); dispose lock;
  return found;
}

// Schreibt den Cache-Pfad von name@version auf stdout, mit Zeilenumbruch.
//
// Mit entry=true wird stattdessen die Unit-Datei im Paket ausgegeben. Der
// Unterschied ist fuer den Compiler wesentlich: er sucht zu `import net.http`
// eine Datei, der Cache liefert aber ein Verzeichnis
// (~/.lpm/cache/net/http/0.1.0/) — und darin heisst die Unit nicht
// "net/http.lyx", sondern so, wie das Manifest es sagt. Ohne diese Aufloesung
// muesste der Compiler das Paketlayout kennen.
//
// Reihenfolge: [build] entry aus der lyx.toml des Pakets, sonst das letzte
// Namenssegment als <segment>.lyx, sonst <segment>.lyu. Rueckgabe: false, wenn
// keine dieser Dateien existiert.
fn cmdPrintCachePath(home: pchar, name: pchar, version: pchar, entry: bool): bool {
  var dir: pchar := LpmCachePkgPath(home, name, version);

  if !entry {
    sys_write(1, dir as int64, StrLen(dir));
    sys_write(1, "\n"c as int64, 1);
    LpmCacheFreePath(dir);
    return true;
  }

  var file: int64 := alloc(CMD_PATH_MAX);
  var ok: bool := cmdEntryPath(dir, name, file, CMD_PATH_MAX);
  LpmCacheFreePath(dir);

  if ok {
    sys_write(1, file, StrLen(file as pchar));
    sys_write(1, "\n"c as int64, 1);
  }
  free(file, CMD_PATH_MAX);
  return ok;
}

// Letztes Segment eines Paketnamens ("net/http" -> "http").
fn cmdLastSegment(name: pchar): pchar {
  var n: int64 := StrLen(name);
  var last: int64 := 0;
  var i: int64 := 0;
  while i < n {
    if peek8(name as int64 + i) as int64 == 47 { last := i + 1; }
    i := i + 1;
  }
  return (name as int64 + last) as pchar;
}

// Sucht die Unit-Datei eines entpackten Pakets. Siehe cmdPrintCachePath.
fn cmdEntryPath(dir: pchar, name: pchar, out: int64, cap: int64): bool {
  // 1. [build] entry aus der lyx.toml des Pakets
  var toml: int64 := alloc(CMD_PATH_MAX);
  var p: int64 := 0;
  p := cmdWrS(toml, p, dir);
  p := cmdWrS(toml, p, "/lyx.toml"c);
  poke8(toml + p, 0);

  if FileExists(toml as pchar) {
    var mf: Manifest := new Manifest();
    mf.MfInit();
    if mf.MfRead(toml as pchar) {
      var e: pchar := mf.MfEntry();
      if e != 0 as pchar {
        if peek8(e as int64) as int64 != 0 {
          p := 0;
          p := cmdWrS(out, p, dir);
          p := cmdWrS(out, p, "/"c);
          p := cmdWrS(out, p, e);
          poke8(out + p, 0);
          if FileExists(out as pchar) {
            mf.MfFree(); dispose mf;
            free(toml, CMD_PATH_MAX);
            return true;
          }
        }
      }
    }
    mf.MfFree(); dispose mf;
  }
  free(toml, CMD_PATH_MAX);

  // 2. <letztes Namenssegment>.lyx, 3. dasselbe mit .lyu
  var seg: pchar := cmdLastSegment(name);
  p := 0;
  p := cmdWrS(out, p, dir);
  p := cmdWrS(out, p, "/"c);
  p := cmdWrS(out, p, seg);
  var base: int64 := p;
  p := cmdWrS(out, p, ".lyx"c);
  poke8(out + p, 0);
  if FileExists(out as pchar) { return true; }

  p := base;
  p := cmdWrS(out, p, ".lyu"c);
  poke8(out + p, 0);
  if FileExists(out as pchar) { return true; }

  return false;
}

fn lpmResolve(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var arg: pchar := ctx.LcSubArg(0);
  if arg == 0 as pchar {
    cmdEOutLn("lpm: error: resolve braucht einen Paket- oder Importnamen."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  if home == 0 as pchar {
    cmdEOutLn("lpm: error: HOME ist nicht gesetzt."c);
    return 1;
  }

  // --entry: statt des Verzeichnisses die Unit-Datei ausgeben. Das ist die
  // Form, die lyxc direkt einsetzen kann.
  var wantEntry: bool := ctx.LcHasFlag("--entry"c);

  var name: int64 := alloc(CMD_NAME_MAX);
  if !cmdImportToPkg(arg, name, CMD_NAME_MAX) {
    cmdEOutLn("lpm: error: Paketname unbrauchbar."c);
    free(name, CMD_NAME_MAX);
    return 1;
  }
  var pkg: pchar := name as pchar;

  // 1. Steht die Version im Lock und liegt sie im Cache? Dann sofort fertig —
  //    das ist der haeufigste Fall waehrend einer Kompilierung und darf weder
  //    das Netz noch die Uhr anfassen.
  var ver: int64 := alloc(CMD_NAME_MAX);
  var locked: bool := cmdLockedVersion(pkg, ver, CMD_NAME_MAX);
  if locked {
    // Auch hier gegen FILES.sha256 pruefen: der Compiler bekommt gleich einen
    // Pfad, aus dem er uebersetzt. Schlaegt die Pruefung an, faellt der Aufruf
    // in die vollstaendige Aufloesung unten und holt das Paket neu.
    var cached: bool := false;
    if LpmCacheHas(home, pkg, ver as pchar) {
      cmdOutFd := 2;
      cached := cmdVerifyCached(ctx, home, pkg, ver as pchar);
      cmdOutFd := 1;
    }
    if cached {
      if cmdPrintCachePath(home, pkg, ver as pchar, wantEntry) {
        free(ver, CMD_NAME_MAX);
        free(name, CMD_NAME_MAX);
        return 0;
      }
      cmdEOut("lpm: error: "c); cmdEOut(pkg);
      cmdEOutLn(": keine Unit-Datei im Paket gefunden."c);
      free(ver, CMD_NAME_MAX);
      free(name, CMD_NAME_MAX);
      return 1;
    }
  }

  // 2. Sonst aufloesen wie bei `install` — inklusive Download, Hash-Pruefung
  //    und Lock-Aktualisierung. Der Compiler bekommt damit ein Paket, das auch
  //    ein spaeteres `lpm install` genau so herstellen wuerde.
  var mf: Manifest := new Manifest();
  mf.MfInit();
  cmdLoadManifest(mf);

  var cons: pchar := "*"c;
  if locked { cons := ver as pchar; }
  mf.MfSetDep(pkg, cons);

  cmdOutFd := 2;
  var rc: int64 := cmdResolveAndLock(ctx, home, mf);
  cmdOutFd := 1;
  mf.MfFree(); dispose mf;
  free(ver, CMD_NAME_MAX);

  if rc != CMD_RES_OK {
    cmdEOut("lpm: error: "c); cmdEOut(pkg);
    cmdEOutLn(" liess sich nicht aufloesen."c);
    free(name, CMD_NAME_MAX);
    return 1;
  }

  // 3. Version aus dem frisch geschriebenen Lock nehmen.
  var ver2: int64 := alloc(CMD_NAME_MAX);
  var ok: bool := cmdLockedVersion(pkg, ver2, CMD_NAME_MAX);
  if !ok {
    cmdEOut("lpm: error: "c); cmdEOut(pkg);
    cmdEOutLn(" steht nach der Aufloesung nicht in lyx.lock."c);
    free(ver2, CMD_NAME_MAX);
    free(name, CMD_NAME_MAX);
    return 1;
  }
  if !LpmCacheHas(home, pkg, ver2 as pchar) {
    cmdEOut("lpm: error: "c); cmdEOut(pkg);
    cmdEOutLn(" ist aufgeloest, liegt aber nicht im Cache."c);
    free(ver2, CMD_NAME_MAX);
    free(name, CMD_NAME_MAX);
    return 1;
  }

  var printed: bool := cmdPrintCachePath(home, pkg, ver2 as pchar, wantEntry);
  free(ver2, CMD_NAME_MAX);
  free(name, CMD_NAME_MAX);
  if !printed {
    cmdEOut("lpm: error: "c); cmdEOut(pkg);
    cmdEOutLn(": keine Unit-Datei im Paket gefunden."c);
    return 1;
  }
  return 0;
}

// ---------------------------------------------------------------------------
// pack — aus dem aktuellen Verzeichnis ein .lxpkg bauen
// ---------------------------------------------------------------------------

fn lpmPack(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var dir: pchar := ctx.LcSubArg(0);
  if dir == 0 as pchar { dir := "."c; }

  // Name und Version kommen aus dem Manifest des Pakets, nicht von der
  // Kommandozeile: ein Archiv, dessen Dateiname nicht zu seinem Inhalt passt,
  // waere die erste Quelle fuer Verwechslungen in der Registry.
  var toml: int64 := alloc(CMD_PATH_MAX);
  var tp: int64 := 0;
  tp := cmdWrS(toml, tp, dir);
  tp := cmdWrS(toml, tp, "/lyx.toml"c);
  poke8(toml + tp, 0);

  if !FileExists(toml as pchar) {
    cmdErr(PkErrStr(PK_ERR_NOTOML));
    free(toml, CMD_PATH_MAX);
    return 1;
  }

  var mf: Manifest := new Manifest();
  mf.MfInit();
  var read: bool := mf.MfRead(toml as pchar);
  free(toml, CMD_PATH_MAX);
  if !read {
    cmdErr("lyx.toml liess sich nicht lesen."c);
    mf.MfFree(); dispose mf;
    return 1;
  }

  var pname: pchar := mf.MfName();
  var pver:  pchar := mf.MfVersion();
  var haveName: bool := false;
  var haveVer:  bool := false;
  if pname != 0 as pchar { if peek8(pname as int64) as int64 != 0 { haveName := true; } }
  if pver  != 0 as pchar { if peek8(pver  as int64) as int64 != 0 { haveVer  := true; } }
  if !haveName || !haveVer {
    cmdErr(PkErrStr(PK_ERR_MANIFEST));
    mf.MfFree(); dispose mf;
    return 1;
  }

  var fname: int64 := alloc(CMD_PATH_MAX);
  if !PkArchiveName(pname, pver, fname, CMD_PATH_MAX) {
    cmdErr("Paketname oder Version zu lang."c);
    free(fname, CMD_PATH_MAX);
    mf.MfFree(); dispose mf;
    return 1;
  }

  var out: int64 := alloc(CMD_PATH_MAX);
  var op: int64 := 0;
  op := cmdWrS(out, op, dir);
  op := cmdWrS(out, op, "/"c);
  op := cmdWrS(out, op, fname as pchar);
  poke8(out + op, 0);
  free(fname, CMD_PATH_MAX);

  var sha: int64 := alloc(65);
  var rc: int64 := PkBuild(dir, out as pchar, sha);

  if rc != PK_OK {
    cmdErr(PkErrStr(rc));
    free(sha, 65);
    free(out, CMD_PATH_MAX);
    mf.MfFree(); dispose mf;
    return 1;
  }

  cmdOut("lpm: "c); cmdOut(pname); cmdOut("@"c); cmdOut(pver);
  cmdOutLn(" gepackt:"c);
  cmdOut("  "c); cmdOutLn(out as pchar);
  cmdOut("  sha256 "c); cmdOutLn(sha as pchar);
  cmdOut("  "c); cmdOutInt(FileSize(out as pchar)); cmdOutLn(" Bytes"c);

  free(sha, 65);
  free(out, CMD_PATH_MAX);
  mf.MfFree(); dispose mf;
  return 0;
}

// ---------------------------------------------------------------------------
// login / logout — Registry-Token verwalten
// ---------------------------------------------------------------------------

// Die Registry, auf die sich der Aufruf bezieht.
fn cmdRegistry(ctx: LpmCtx): pchar {
  var r: pchar := ctx.lcRegistry;
  if r == 0 as pchar { r := arDefaultRegistry(); }
  return r;
}

fn lpmLogin(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var token: pchar := ctx.LcFlagVal("--token"c);
  if token == 0 as pchar { token := ctx.LcSubArg(0); }
  if token == 0 as pchar {
    cmdErr("Verwendung: lpm login --token=<token> [--registry=<url>]"c);
    cmdOutLn("     Den Token stellt der Registry-Betreiber aus."c);
    return 1;
  }
  if StrLen(token) >= CR_TOKEN_MAX {
    cmdErr("Token zu lang."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  var registry: pchar := cmdRegistry(ctx);

  if !CrStore(home, registry, token) {
    cmdErr("Token liess sich nicht speichern (~/.lpm/credentials)."c);
    return 1;
  }

  // Der Token selbst wird nicht ausgegeben — auch nicht gekuerzt. Wer ihn
  // sehen will, liest die Datei; wer ein Protokoll teilt, teilt ihn nicht mit.
  cmdOut("lpm: angemeldet an "c); cmdOutLn(registry);
  cmdOutLn("     Token in ~/.lpm/credentials (nur fuer dich lesbar)."c);
  return 0;
}

fn lpmLogout(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var home: pchar := cmdGetHome(argc, argv);
  var registry: pchar := cmdRegistry(ctx);

  if !CrForget(home, registry) {
    cmdErr("Token liess sich nicht entfernen."c);
    return 1;
  }
  cmdOut("lpm: abgemeldet von "c); cmdOutLn(registry);
  return 0;
}

// ---------------------------------------------------------------------------
// publish — ein .lxpkg in die Registry laden
// ---------------------------------------------------------------------------

fn lpmPublish(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  if ctx.lcOffline {
    cmdErr("publish braucht Netzwerk, --offline ist gesetzt."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  var registry: pchar := cmdRegistry(ctx);

  var token: int64 := alloc(CR_TOKEN_MAX);
  if !CrLoad(home, registry, token) {
    free(token, CR_TOKEN_MAX);
    cmdErr("nicht angemeldet — erst 'lpm login --token=<token>' ausfuehren."c);
    return 1;
  }

  // Manifest des zu veroeffentlichenden Verzeichnisses
  var dir: pchar := ctx.LcSubArg(0);
  if dir == 0 as pchar { dir := "."c; }

  var toml: int64 := alloc(CMD_PATH_MAX);
  var tp: int64 := 0;
  tp := cmdWrS(toml, tp, dir);
  tp := cmdWrS(toml, tp, "/lyx.toml"c);
  poke8(toml + tp, 0);

  var mf: Manifest := new Manifest();
  mf.MfInit();
  var read: bool := false;
  if FileExists(toml as pchar) { read := mf.MfRead(toml as pchar); }
  free(toml, CMD_PATH_MAX);

  if !read {
    cmdErr("kein lesbares lyx.toml in diesem Verzeichnis."c);
    mf.MfFree(); dispose mf;
    free(token, CR_TOKEN_MAX);
    return 1;
  }

  var pname: pchar := mf.MfName();
  var pver:  pchar := mf.MfVersion();
  if pname == 0 as pchar || pver == 0 as pchar {
    cmdErr(PkErrStr(PK_ERR_MANIFEST));
    mf.MfFree(); dispose mf;
    free(token, CR_TOKEN_MAX);
    return 1;
  }

  // Immer frisch packen statt ein herumliegendes Archiv zu nehmen: sonst laedt
  // man irgendwann den Stand von vorgestern hoch, ohne es zu merken.
  var fname: int64 := alloc(CMD_PATH_MAX);
  PkArchiveName(pname, pver, fname, CMD_PATH_MAX);
  var archive: int64 := alloc(CMD_PATH_MAX);
  var ap: int64 := 0;
  ap := cmdWrS(archive, ap, dir);
  ap := cmdWrS(archive, ap, "/"c);
  ap := cmdWrS(archive, ap, fname as pchar);
  poke8(archive + ap, 0);
  free(fname, CMD_PATH_MAX);

  var sha: int64 := alloc(65);
  var prc: int64 := PkBuild(dir, archive as pchar, sha);
  if prc != PK_OK {
    cmdErr(PkErrStr(prc));
    free(sha, 65); free(archive, CMD_PATH_MAX);
    mf.MfFree(); dispose mf;
    free(token, CR_TOKEN_MAX);
    return 1;
  }

  var deps: int64 := alloc(CMD_JSON_DEPS_MAX);
  if !mf.MfDepsJson(deps, CMD_JSON_DEPS_MAX) {
    cmdErr("zu viele Dependencies fuer eine Kopfzeile."c);
    free(deps, CMD_JSON_DEPS_MAX);
    free(sha, 65); free(archive, CMD_PATH_MAX);
    mf.MfFree(); dispose mf;
    free(token, CR_TOKEN_MAX);
    return 1;
  }

  cmdOut("lpm: veroeffentliche "c); cmdOut(pname); cmdOut("@"c); cmdOut(pver);
  cmdOut(" an "c); cmdOutLn(registry);
  if ctx.lcVerbose {
    cmdOut("     "c); cmdOutLn(archive as pchar);
    cmdOut("     sha256 "c); cmdOutLn(sha as pchar);
  }

  var statusBox: int64 := alloc(8);
  var reply: int64 := alloc(FT_REPLY_MAX);
  var rc: int64 := FtPublish(registry, token as pchar, pname, pver,
                             sha as pchar, deps as pchar, mf.MfDesc(),
                             archive as pchar, statusBox, reply);
  var status: int64 := peek64(statusBox);
  free(statusBox, 8);

  if rc != FT_OK {
    cmdOut("lpm: error: "c); cmdOutLn(FtErrStr(rc));
    if status > 0 {
      cmdOut("     HTTP "c); cmdOutInt(status); cmdOutLn(""c);
    }
    // Die Antwort der Registry ist meist genauer als alles, was der Client
    // daraus schliessen koennte — deshalb unveraendert weiterreichen.
    if peek8(reply) as int64 != 0 {
      cmdOutLn("     Antwort der Registry:"c);
      cmdOutLn(reply as pchar);
    }
    free(reply, FT_REPLY_MAX);
    free(deps, CMD_JSON_DEPS_MAX);
    free(sha, 65); free(archive, CMD_PATH_MAX);
    mf.MfFree(); dispose mf;
    free(token, CR_TOKEN_MAX);
    return 1;
  }

  cmdOut("lpm: "c); cmdOut(pname); cmdOut("@"c); cmdOut(pver);
  cmdOutLn(" ist veroeffentlicht."c);
  cmdOut("     sha256 "c); cmdOutLn(sha as pchar);

  free(reply, FT_REPLY_MAX);
  free(deps, CMD_JSON_DEPS_MAX);
  free(sha, 65); free(archive, CMD_PATH_MAX);
  mf.MfFree(); dispose mf;
  free(token, CR_TOKEN_MAX);
  return 0;
}

// ---------------------------------------------------------------------------
// Stubs für netzwerkabhängige Befehle
// ---------------------------------------------------------------------------

fn lpmNotImpl(cmd: pchar): int64 {
  cmdOut("lpm: '"c);
  cmdOut(cmd);
  cmdOutLn("' ist noch nicht implementiert (Netzwerk-WPs folgen)."c);
  return 1;
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------

pub fn lpmDispatch(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var cmd: pchar := ctx.LcSubcmd();
  if cmd == 0 as pchar {
    lpmHelp();
    return 1;
  }

  if StrCmp(cmd, "init"c)    == 0 { return lpmInit(ctx); }
  if StrCmp(cmd, "install"c) == 0 { return lpmInstall(ctx, argc, argv); }
  if StrCmp(cmd, "remove"c)  == 0 { return lpmRemove(ctx, argc, argv); }
  if StrCmp(cmd, "update"c)  == 0 { return lpmUpdate(ctx, argc, argv); }
  if StrCmp(cmd, "search"c)  == 0 { return lpmSearch(ctx, argc, argv); }
  if StrCmp(cmd, "info"c)    == 0 { return lpmInfo(ctx, argc, argv); }
  if StrCmp(cmd, "list"c)    == 0 { return lpmList(argc, argv); }
  if StrCmp(cmd, "pack"c)    == 0 { return lpmPack(ctx, argc, argv); }
  if StrCmp(cmd, "publish"c) == 0 { return lpmPublish(ctx, argc, argv); }
  if StrCmp(cmd, "login"c)   == 0 { return lpmLogin(ctx, argc, argv); }
  if StrCmp(cmd, "logout"c)  == 0 { return lpmLogout(ctx, argc, argv); }
  if StrCmp(cmd, "resolve"c) == 0 { return lpmResolve(ctx, argc, argv); }

  if StrCmp(cmd, "cache"c) == 0 {
    // Achtung: && schliesst hier nicht kurz — Null-Check muss geschachtelt sein.
    var sub: pchar := ctx.LcSubArg(0);
    if sub != 0 as pchar {
      if StrCmp(sub, "list"c)  == 0 { return lpmCacheList(argc, argv); }
      if StrCmp(sub, "clean"c) == 0 { return lpmCacheClean(argc, argv); }
      if StrCmp(sub, "add"c)   == 0 { return lpmCacheAdd(ctx, argc, argv); }
    }
    cmdOutLn("lpm cache: Subcommand erwartet: list | clean | add"c);
    return 1;
  }

  cmdOut("lpm: unbekannter Befehl '"c);
  cmdOut(cmd);
  cmdOutLn("'. Siehe: lpm --help"c);
  return 1;
}

// ---------------------------------------------------------------------------
// Einstiegspunkt — wird von main.lyx aufgerufen
// ---------------------------------------------------------------------------

pub fn lpmMain(argc: int64, argv: pchar): int64 {
  if argc < 2 {
    lpmHelp();
    return 1;
  }

  // Globale Flags zuerst prüfen (vor LpmCtx — einfache lineare Suche)
  var i: int64 := 1;
  while i < argc {
    var arg: pchar := ArgvGet(argv, i);
    if StrCmp(arg, "--help"c) == 0 || StrCmp(arg, "-h"c) == 0 {
      lpmHelp(); return 0;
    }
    if StrCmp(arg, "--version"c) == 0 || StrCmp(arg, "-V"c) == 0 {
      lpmVersion(); return 0;
    }
    i := i + 1;
  }

  var ctx: LpmCtx := new LpmCtx();
  ctx.LcInit(argc, argv);
  var result: int64 := lpmDispatch(ctx, argc, argv);
  dispose ctx;
  return result;
}
