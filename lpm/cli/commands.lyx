// ---------------------------------------------------------------------------
// lpm cache add <archiv.lxpkg> <name> <version> [--sha256=<hex>]
// Installiert ein lokal vorliegendes .lxpkg in den Cache. Damit ist der
// Install-Pfad ohne Netzwerk testbar (Akzeptanzkriterium WP-PM-03).
// ---------------------------------------------------------------------------

fn lpmCacheAdd(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var archive: pchar := ctx.LcSubArg(1);
  var name:    pchar := ctx.LcSubArg(2);
  var version: pchar := ctx.LcSubArg(3);

  if archive == 0 as pchar {
    cmdErr("Verwendung: lpm cache add <archiv.lxpkg> <name> <version>"c);
    return 1;
  }
  if name == 0 as pchar {
    cmdErr("Verwendung: lpm cache add <archiv.lxpkg> <name> <version>"c);
    return 1;
  }
  if version == 0 as pchar {
    cmdErr("Verwendung: lpm cache add <archiv.lxpkg> <name> <version>"c);
    return 1;
  }
  if FileExists(archive) == false {
    cmdErr("Archiv nicht gefunden."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  LpmCacheEnsure(home);
  var dest: pchar := LpmCachePkgPath(home, name, version);

  var expect: pchar := ctx.LcFlagVal("--sha256"c);
  var rc: int64 := 0;
  if expect == 0 as pchar {
    rc := LpmUnpackLxpkg(archive, dest);
  } else {
    rc := LpmUnpackLxpkgVerified(archive, dest, expect);
  }

  if rc < 0 {
    cmdErr(LpmArchiveErrStr(rc));
    LpmCacheFreePath(dest);
    return 1;
  }

  cmdOut("lpm: "c);
  cmdOut(name);
  cmdOut("@"c);
  cmdOut(version);
  cmdOut(" entpackt nach "c);
  cmdOutLn(dest);
  LpmCacheFreePath(dest);
  return 0;
}

// ---------------------------------------------------------------------------
// WP-PM-06: Install-Flow
//
// Manifest -> Katalog -> Resolver -> lyx.lock. Der Katalog kommt aus dem
// lokalen Cache und dem gespiegelten Registry-Index. Fehlt ein Paket im
// Katalog, holt WP-PM-05 (Teil 2) dessen Index per HTTPS nach und die
// Aufloesung laeuft erneut — siehe cmdResolveAndLock. Der Download der
// Archive selbst folgt mit WP-PM-07; was aufgeloest ist, aber nicht im Cache
// liegt, wird bis dahin ausgewiesen.
// ---------------------------------------------------------------------------

con CMD_RES_OK:         int64 := 0;
con CMD_RES_FAIL:       int64 := 1;
con CMD_RES_INCOMPLETE: int64 := 2;

// Obergrenze fuer nachgeladene Indizes je Aufloesung. Die Grenze ist eine
// Reissleine gegen eine Registry, die immer neue Namen nachschiebt, kein
// erwarteter Normalfall.
con CMD_SYNC_MAX:  int64 := 64;
con CMD_NAME_MAX:  int64 := 256;

// Steht name schon in der Liste der in diesem Lauf versuchten Indizes?
fn cmdSeenHas(seen: int64, n: int64, name: pchar): bool {
  var i: int64 := 0;
  while i < n {
    if StrCmp((seen + i * CMD_NAME_MAX) as pchar, name) == 0 { return true; }
    i := i + 1;
  }
  return false;
}

// Kopiert name in die Liste. Rueckgabe: neue Anzahl (unveraendert, wenn der
// Name nicht hineinpasst).
fn cmdSeenAdd(seen: int64, n: int64, name: pchar): int64 {
  var slen: int64 := StrLen(name);
  if slen >= CMD_NAME_MAX { return n; }
  memcpy(seen + n * CMD_NAME_MAX, name as int64, slen);
  poke8(seen + n * CMD_NAME_MAX + slen, 0);
  return n + 1;
}

// Holt den Registry-Index eines Pakets nach. Rueckgabe: true, wenn der Spiegel
// danach neu ist und ein weiterer Aufloesungsversuch Sinn hat.
fn cmdSyncIndex(ctx: LpmCtx, home: pchar, name: pchar): bool {
  var registry: pchar := ctx.lcRegistry;
  if registry == 0 as pchar { registry := arDefaultRegistry(); }

  if ctx.lcVerbose {
    cmdOut("lpm: hole Index fuer "c); cmdOut(name);
    cmdOut(" von "c); cmdOutLn(registry);
  }

  var rc: int64 := FtSyncPackageIndex(home, registry, name);
  if rc == FT_OK { return true; }

  // FT_ERR_404 heisst schlicht: das Paket gibt es nicht. Das meldet gleich
  // darauf der Resolver mit RS_ERR_MISSING, hier waere es doppelt.
  if rc != FT_ERR_404 {
    cmdOut("lpm: warning: "c); cmdOut(name); cmdOut(": "c);
    cmdOutLn(FtErrStr(rc));
  }
  return false;
}

// Baut den Katalog aus allen lokal verfuegbaren Quellen auf.
fn cmdBuildCatalog(home: pchar, cat: DepCatalog, verbose: bool): void {
  var cacheDir: pchar := LpmCacheDir(home);
  var fromCache: int64 := LcFromCache(cacheDir, cat);
  LpmCacheFreePath(cacheDir);

  var regDir: pchar := LpmCacheRegistryDir(home);
  var fromIndex: int64 := LcFromIndexDir(regDir, cat);
  LpmCacheFreePath(regDir);

  if verbose {
    cmdOut("lpm: Katalog: "c); PrintInt(fromCache);
    cmdOut(" aus dem Cache, "c); PrintInt(fromIndex);
    cmdOutLn(" aus gespiegelten Indizes."c);
  }
}

// Traegt alle Dependencies des Manifests als Wurzeln ein.
fn cmdAddRoots(mf: Manifest, r: Resolver): void {
  var i: int64 := 0;
  while i < mf.MfDepCount() {
    r.RsAddRoot(mf.MfDepName(i), mf.MfDepVer(i));
    i := i + 1;
  }
}

// Gibt einen Resolver-Fehler mit Kontext aus.
fn cmdResolveErr(r: Resolver, rc: int64): void {
  cmdOut("lpm: error: "c);
  cmdOut(r.RsErrStr(rc));
  var pkg: pchar := r.RsErrPkg();
  if pkg != 0 as pchar {
    cmdOut(" — "c);
    cmdOut(pkg);
  }
  var a: pchar := r.RsErrConsA();
  var b: pchar := r.RsErrConsB();
  if a != 0 as pchar {
    if b != 0 as pchar {
      cmdOut(" ("c); cmdOut(a); cmdOut(" gegen "c); cmdOut(b); cmdOut(")"c);
    } else {
      cmdOut(" ("c); cmdOut(a); cmdOut(")"c);
    }
  }
  cmdOutLn(""c);
}

// Erfuellt das vorhandene lyx.lock bereits alle Manifest-Constraints?
// Dann wird nicht neu aufgeloest — zweites `lpm install` ohne Aenderung soll
// nichts tun (Akzeptanzkriterium WP-PM-06).
fn cmdLockSatisfies(mf: Manifest, lock: LockFile): bool {
  var i: int64 := 0;
  while i < mf.MfDepCount() {
    var idx: int64 := lock.LfFind(mf.MfDepName(i));
    if idx < 0 { return false; }
    var v: SemVer := new SemVer();
    v.SvParse(lock.LfGetVer(idx));
    var ok: bool := false;
    if v.svValid {
      if v.SvSatisfies(mf.MfDepVer(i)) { ok := true; }
    }
    dispose v;
    if !ok { return false; }
    i := i + 1;
  }
  return true;
}

// Loest auf und schreibt lyx.lock.
// Rueckgabe: CMD_RES_OK, CMD_RES_FAIL (Aufloesung gescheitert) oder
// CMD_RES_INCOMPLETE (aufgeloest, aber nicht alles liegt lokal vor).
// Der Aufrufer muss die Faelle unterscheiden: bei CMD_RES_FAIL darf lyx.toml
// nicht veraendert werden, sonst bleibt ein unaufloesbares Paket darin stehen.
fn cmdResolveAndLock(ctx: LpmCtx, home: pchar, mf: Manifest): int64 {
  // Aufloesen, und bei einem unbekannten Paket dessen Index nachladen und noch
  // einmal aufloesen. Transitive Dependencies tauchen erst auf, wenn der Index
  // ihres Elternpakets gelesen ist — deshalb die Schleife statt eines einzelnen
  // Vorab-Downloads der Manifest-Wurzeln.
  var seen: int64 := alloc(CMD_SYNC_MAX * CMD_NAME_MAX);
  var seenN: int64 := 0;

  var cat: DepCatalog := 0 as DepCatalog;
  var r: Resolver := 0 as Resolver;
  var rc: int64 := 0;

  while true {
    cat := new DepCatalog();
    cat.DcInit();
    cmdBuildCatalog(home, cat, ctx.lcVerbose);

    r := new Resolver();
    r.RsInit(cat);
    cmdAddRoots(mf, r);

    rc := r.RsResolve();
    if rc != RS_ERR_MISSING { break; }
    if ctx.lcOffline { break; }
    if seenN >= CMD_SYNC_MAX { break; }

    var miss: pchar := r.RsErrPkg();
    if miss == 0 as pchar { break; }
    if cmdSeenHas(seen, seenN, miss) { break; }

    // Namen sichern, bevor der Resolver freigegeben wird — miss zeigt in ihn.
    var before: int64 := seenN;
    seenN := cmdSeenAdd(seen, seenN, miss);
    if seenN == before { break; }
    var name: pchar := (seen + before * CMD_NAME_MAX) as pchar;

    // Erst holen, dann freigeben: bringt der Download nichts Neues, bleibt das
    // vorhandene Ergebnis samt Fehlerkontext stehen und wird gemeldet.
    if !cmdSyncIndex(ctx, home, name) { break; }

    r.RsFree(); dispose r;
    cat.DcFree(); dispose cat;
  }

  free(seen, CMD_SYNC_MAX * CMD_NAME_MAX);

  if rc != RS_OK {
    cmdResolveErr(r, rc);
    r.RsFree(); dispose r;
    cat.DcFree(); dispose cat;
    return CMD_RES_FAIL;
  }

  var lock: LockFile := new LockFile();
  lock.LfInit();
  r.RsToLock(lock);

  var written: bool := lock.LfWrite("lyx.lock"c);
  if !written { cmdErr("lyx.lock konnte nicht geschrieben werden."c); }

  // Was fehlt noch im Cache?
  var missing: int64 := 0;
  var n: int64 := 0;
  while n < r.RsCount() {
    var nm: pchar := r.RsName(n);
    var vr: pchar := r.RsVer(n);
    if LpmCacheHas(home, nm, vr) {
      if ctx.lcVerbose {
        cmdOut("lpm: "c); cmdOut(nm); cmdOut("@"c); cmdOut(vr);
        cmdOutLn(" liegt im Cache."c);
      }
    } else {
      missing := missing + 1;
      cmdOut("lpm: fehlt im Cache: "c); cmdOut(nm); cmdOut("@"c); cmdOutLn(vr);
    }
    n := n + 1;
  }

  cmdOut("lpm: "c); PrintInt(r.RsCount());
  cmdOutLn(" Paket(e) aufgeloest, lyx.lock geschrieben."c);

  if missing > 0 {
    cmdOut("lpm: "c); PrintInt(missing);
    cmdOutLn(" Paket(e) fehlen lokal. Der Archiv-Download folgt mit WP-PM-07."c);
    cmdOutLn("     Solange hilft: lpm cache add <archiv.lxpkg> <name> <version>"c);
  }

  lock.LfFree(); dispose lock;
  r.RsFree(); dispose r;
  cat.DcFree(); dispose cat;

  if !written { return CMD_RES_FAIL; }
  if missing > 0 { return CMD_RES_INCOMPLETE; }
  return CMD_RES_OK;
}

// Liest lyx.toml, legt es an wenn es fehlt.
fn cmdLoadManifest(mf: Manifest): bool {
  if FileExists("lyx.toml"c) { return mf.MfRead("lyx.toml"c); }
  return false;
}

// Trennt "name@constraint" auf. Gibt das Constraint zurueck (Zeiger in einen
// eigenen Puffer) und kuerzt name in place. Ohne '@' wird "latest" geliefert.
fn cmdSplitSpec(spec: pchar, nameOut: int64, cap: int64): pchar {
  var slen: int64 := StrLen(spec);
  var at: int64 := 0 - 1;
  var i: int64 := 0;
  while i < slen {
    if peek8(spec as int64 + i) as int64 == 64 { at := i; }
    i := i + 1;
  }
  if at < 0 {
    if slen >= cap { return 0 as pchar; }
    memcpy(nameOut, spec as int64, slen);
    poke8(nameOut + slen, 0);
    return "latest"c;
  }
  if at >= cap { return 0 as pchar; }
  memcpy(nameOut, spec as int64, at);
  poke8(nameOut + at, 0);
  return (spec as int64 + at + 1) as pchar;
}

fn lpmInstall(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var home: pchar := cmdGetHome(argc, argv);
  var mf: Manifest := new Manifest();
  mf.MfInit();

  var haveToml: bool := cmdLoadManifest(mf);
  var spec: pchar := ctx.LcSubArg(0);

  if !haveToml {
    if spec == 0 as pchar {
      cmdErr("Kein lyx.toml in diesem Verzeichnis. Erst 'lpm init' ausfuehren."c);
      mf.MfFree(); dispose mf;
      return 1;
    }
    // `lpm install <pkg>` in leerem Verzeichnis legt das Manifest an.
    mf.MfAddDep("__placeholder__"c, "*"c);
    mf.MfRemoveDep("__placeholder__"c);
  }

  if spec != 0 as pchar {
    var nameBuf: int64 := alloc(512);
    var cons: pchar := cmdSplitSpec(spec, nameBuf, 512);
    if cons == 0 as pchar {
      cmdErr("Paketname zu lang."c);
      free(nameBuf, 512);
      mf.MfFree(); dispose mf;
      return 1;
    }
    // Nur im Speicher — geschrieben wird erst, wenn die Aufloesung haelt.
    mf.MfSetDep(nameBuf as pchar, cons);
    free(nameBuf, 512);
  }

  if mf.MfDepCount() == 0 {
    cmdOutLn("lpm: keine Dependencies in lyx.toml — nichts zu tun."c);
    mf.MfFree(); dispose mf;
    return 0;
  }

  // Bereits geloestes Lock-File nicht neu berechnen.
  if spec == 0 as pchar {
    if FileExists("lyx.lock"c) {
      var lock: LockFile := new LockFile();
      lock.LfInit();
      if lock.LfRead("lyx.lock"c) {
        if cmdLockSatisfies(mf, lock) {
          cmdOutLn("lpm: lyx.lock ist aktuell — nichts zu tun."c);
          lock.LfFree(); dispose lock;
          mf.MfFree(); dispose mf;
          return 0;
        }
      }
      lock.LfFree(); dispose lock;
    }
  }

  var rc: int64 := cmdResolveAndLock(ctx, home, mf);

  if rc == CMD_RES_FAIL {
    if spec != 0 as pchar {
      cmdOutLn("lpm: lyx.toml bleibt unveraendert."c);
    }
    mf.MfFree(); dispose mf;
    return 1;
  }

  if spec != 0 as pchar {
    if !mf.MfWrite("lyx.toml"c) {
      cmdErr("lyx.toml konnte nicht geschrieben werden."c);
      mf.MfFree(); dispose mf;
      return 1;
    }
  }

  mf.MfFree(); dispose mf;
  if rc == CMD_RES_INCOMPLETE { return 1; }
  return 0;
}

fn lpmRemove(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var name: pchar := ctx.LcSubArg(0);
  if name == 0 as pchar {
    cmdErr("Verwendung: lpm remove <pkg>"c);
    return 1;
  }
  if !FileExists("lyx.toml"c) {
    cmdErr("Kein lyx.toml in diesem Verzeichnis."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  var mf: Manifest := new Manifest();
  mf.MfInit();
  if !mf.MfRead("lyx.toml"c) {
    cmdErr("lyx.toml konnte nicht gelesen werden."c);
    mf.MfFree(); dispose mf;
    return 1;
  }

  if !mf.MfRemoveDep(name) {
    cmdOut("lpm: '"c); cmdOut(name);
    cmdOutLn("' steht nicht in lyx.toml."c);
    mf.MfFree(); dispose mf;
    return 1;
  }

  if !mf.MfWrite("lyx.toml"c) {
    cmdErr("lyx.toml konnte nicht geschrieben werden."c);
    mf.MfFree(); dispose mf;
    return 1;
  }
  cmdOut("lpm: '"c); cmdOut(name); cmdOutLn("' aus lyx.toml entfernt."c);

  if mf.MfDepCount() == 0 {
    // Ohne Dependencies ist auch das Lock leer.
    var empty: LockFile := new LockFile();
    empty.LfInit();
    empty.LfWrite("lyx.lock"c);
    empty.LfFree(); dispose empty;
    cmdOutLn("lpm: lyx.lock geleert."c);
    mf.MfFree(); dispose mf;
    return 0;
  }

  var rc: int64 := cmdResolveAndLock(ctx, home, mf);
  if rc == CMD_RES_FAIL {
    cmdOutLn("lpm: lyx.toml ist aktualisiert, lyx.lock aber unveraendert."c);
  }
  mf.MfFree(); dispose mf;
  if rc == CMD_RES_OK { return 0; }
  return 1;
}

fn lpmList(argc: int64, argv: pchar): int64 {
  if !FileExists("lyx.lock"c) {
    cmdOutLn("lpm: kein lyx.lock — erst 'lpm install' ausfuehren."c);
    return 1;
  }
  var home: pchar := cmdGetHome(argc, argv);
  var lock: LockFile := new LockFile();
  lock.LfInit();
  if !lock.LfRead("lyx.lock"c) {
    cmdErr("lyx.lock konnte nicht gelesen werden."c);
    lock.LfFree(); dispose lock;
    return 1;
  }

  cmdOutLn("Aufgeloeste Pakete (lyx.lock):"c);
  var i: int64 := 0;
  var count: int64 := 0;
  while true {
    var nm: pchar := lock.LfGetName(i);
    if nm == 0 as pchar { break; }
    var vr: pchar := lock.LfGetVer(i);
    cmdOut("  "c); cmdOut(nm); cmdOut("@"c); cmdOut(vr);
    if LpmCacheHas(home, nm, vr) { cmdOutLn(""c); }
    else { cmdOutLn("   (nicht im Cache)"c); }
    count := count + 1;
    i := i + 1;
  }
  if count == 0 { cmdOutLn("  (keine)"c); }

  lock.LfFree(); dispose lock;
  return 0;
}

// ---------------------------------------------------------------------------
// update — Registry-Spiegel auffrischen
// ---------------------------------------------------------------------------
//
// Holt /index.json in den lokalen Spiegel. Die Paket-Indizes kommen weiterhin
// bedarfsgetrieben beim Aufloesen (siehe cmdResolveAndLock); `update` ist der
// Weg, den Gesamtindex fuer `lpm search` (WP-PM-09) frisch zu bekommen.
fn lpmUpdate(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  if ctx.lcOffline {
    cmdErr("update braucht Netzwerk, --offline ist gesetzt."c);
    return 1;
  }

  var home: pchar := cmdGetHome(argc, argv);
  if home == 0 as pchar {
    cmdErr("HOME ist nicht gesetzt."c);
    return 1;
  }

  var registry: pchar := ctx.lcRegistry;
  if registry == 0 as pchar { registry := arDefaultRegistry(); }

  var rc: int64 := FtSyncRootIndex(home, registry);
  if rc != FT_OK {
    cmdOut("lpm: error: "c); cmdOut(registry); cmdOut(": "c);
    cmdOutLn(FtErrStr(rc));
    return 1;
  }

  cmdOut("lpm: Index von "c); cmdOut(registry);
  cmdOutLn(" aktualisiert."c);
  return 0;
}

// ---------------------------------------------------------------------------
// Stubs für netzwerkabhängige Befehle
// ---------------------------------------------------------------------------

fn lpmNotImpl(cmd: pchar): int64 {
  cmdOut("lpm: '"c);
  cmdOut(cmd);
  cmdOutLn("' ist noch nicht implementiert (Netzwerk-WPs folgen)."c);
  return 1;
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------

pub fn lpmDispatch(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var cmd: pchar := ctx.LcSubcmd();
  if cmd == 0 as pchar {
    lpmHelp();
    return 1;
  }

  if StrCmp(cmd, "init"c)    == 0 { return lpmInit(ctx); }
  if StrCmp(cmd, "install"c) == 0 { return lpmInstall(ctx, argc, argv); }
  if StrCmp(cmd, "remove"c)  == 0 { return lpmRemove(ctx, argc, argv); }
  if StrCmp(cmd, "update"c)  == 0 { return lpmUpdate(ctx, argc, argv); }
  if StrCmp(cmd, "search"c)  == 0 { return lpmNotImpl("search"c); }
  if StrCmp(cmd, "info"c)    == 0 { return lpmNotImpl("info"c); }
  if StrCmp(cmd, "list"c)    == 0 { return lpmList(argc, argv); }
  if StrCmp(cmd, "publish"c) == 0 { return lpmNotImpl("publish"c); }
  if StrCmp(cmd, "login"c)   == 0 { return lpmNotImpl("login"c); }
  if StrCmp(cmd, "resolve"c) == 0 { return lpmNotImpl("resolve"c); }

  if StrCmp(cmd, "cache"c) == 0 {
    // Achtung: && schliesst hier nicht kurz — Null-Check muss geschachtelt sein.
    var sub: pchar := ctx.LcSubArg(0);
    if sub != 0 as pchar {
      if StrCmp(sub, "list"c)  == 0 { return lpmCacheList(argc, argv); }
      if StrCmp(sub, "clean"c) == 0 { return lpmCacheClean(argc, argv); }
      if StrCmp(sub, "add"c)   == 0 { return lpmCacheAdd(ctx, argc, argv); }
    }
    cmdOutLn("lpm cache: Subcommand erwartet: list | clean | add"c);
    return 1;
  }

  cmdOut("lpm: unbekannter Befehl '"c);
  cmdOut(cmd);
  cmdOutLn("'. Siehe: lpm --help"c);
  return 1;
}

// ---------------------------------------------------------------------------
// Einstiegspunkt — wird von main.lyx aufgerufen
// ---------------------------------------------------------------------------

pub fn lpmMain(argc: int64, argv: pchar): int64 {
  if argc < 2 {
    lpmHelp();
    return 1;
  }

  // Globale Flags zuerst prüfen (vor LpmCtx — einfache lineare Suche)
  var i: int64 := 1;
  while i < argc {
    var arg: pchar := ArgvGet(argv, i);
    if StrCmp(arg, "--help"c) == 0 || StrCmp(arg, "-h"c) == 0 {
      lpmHelp(); return 0;
    }
    if StrCmp(arg, "--version"c) == 0 || StrCmp(arg, "-V"c) == 0 {
      lpmVersion(); return 0;
    }
    i := i + 1;
  }

  var ctx: LpmCtx := new LpmCtx();
  ctx.LcInit(argc, argv);
  var result: int64 := lpmDispatch(ctx, argc, argv);
  dispose ctx;
  return result;
}
