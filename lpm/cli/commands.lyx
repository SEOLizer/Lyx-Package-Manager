// ---------------------------------------------------------------------------
// Schreib-Hilfsfunktionen (via sys_write — kein io-Import nötig)
// ---------------------------------------------------------------------------

fn cmdWrS(buf: int64, pos: int64, s: pchar): int64 {
  if s == 0 as pchar { return pos; }
  var slen: int64 := StrLen(s);
  memcpy(buf + pos, s as int64, slen);
  return pos + slen;
}

// `lpm resolve` liefert auf stdout ausschliesslich den Cache-Pfad — dort darf
// keine Fortschrittsmeldung dazwischenrutschen. Statt jede Ausgabe einzeln
// umzubiegen, schaltet dieser Schalter den Zielkanal um; alles, was ueber
// cmdOut laeuft, geht dann nach stderr.
var cmdOutFd: int64 := 1;

fn cmdOut(s: pchar): void {
  if s == 0 as pchar { return; }
  sys_write(cmdOutFd, s as int64, StrLen(s));
}
fn cmdOutLn(s: pchar): void {
  if s == 0 as pchar { sys_write(cmdOutFd, "\n"c as int64, 1); return; }
  sys_write(cmdOutFd, s as int64, StrLen(s));
  sys_write(cmdOutFd, "\n"c as int64, 1);
}
// PrintInt schreibt fest auf fd 1 und wuerde die eine Pfad-Zeile von
// `lpm resolve` verschmutzen — deshalb hier eine eigene Fassung, die
// cmdOutFd respektiert.
fn cmdOutInt(n: int64): void {
  if n == 0 { sys_write(cmdOutFd, "0"c as int64, 1); return; }

  var v: int64 := n;
  if v < 0 {
    sys_write(cmdOutFd, "-"c as int64, 1);
    v := 0 - v;
  }

  var buf: int64 := alloc(24);
  var i: int64 := 24;
  while v > 0 {
    i := i - 1;
    poke8(buf + i, (48 + v % 10) as int8);
    v := v / 10;
  }
  sys_write(cmdOutFd, buf + i, 24 - i);
  free(buf, 24);
}

fn cmdErr(s: pchar): void {
  sys_write(2, "lpm: error: "c as int64, 12);
  sys_write(2, s as int64, StrLen(s));
  sys_write(2, "\n"c as int64, 1);
}

// ---------------------------------------------------------------------------
// HOME-Verzeichnis aus envp lesen (envp = argv + (argc+1)*8)
// ---------------------------------------------------------------------------

fn cmdGetHome(argc: int64, argv: pchar): pchar {
  var envp: int64 := argv as int64 + (argc + 1) * 8;
  var i: int64 := 0;
  while true {
    var env: pchar := peek64(envp + i * 8) as pchar;
    if env == 0 as pchar { break; }
    // Check if env starts with "HOME="
    if StrLen(env) > 5 {
      var found: bool := true;
      var homeKey: pchar := "HOME="c;
      var j: int64 := 0;
      while j < 5 {
        if peek8(env as int64 + j) as int64 != peek8(homeKey as int64 + j) as int64 {
          found := false;
          j := 5;
        }
        j := j + 1;
      }
      if found { return (env as int64 + 5) as pchar; }
    }
    i := i + 1;
  }
  return "/root"c;
}

