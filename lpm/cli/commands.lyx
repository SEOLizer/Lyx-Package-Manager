// ---------------------------------------------------------------------------
// Schreib-Hilfsfunktionen (via sys_write — kein io-Import nötig)
// ---------------------------------------------------------------------------

fn cmdWrS(buf: int64, pos: int64, s: pchar): int64 {
  if s == 0 as pchar { return pos; }
  var slen: int64 := StrLen(s);
  memcpy(buf + pos, s as int64, slen);
  return pos + slen;
}

fn cmdOut(s: pchar): void {
  if s == 0 as pchar { return; }
  sys_write(1, s as int64, StrLen(s));
}
fn cmdOutLn(s: pchar): void {
  if s == 0 as pchar { sys_write(1, "\n"c as int64, 1); return; }
  sys_write(1, s as int64, StrLen(s));
  sys_write(1, "\n"c as int64, 1);
}
fn cmdErr(s: pchar): void {
  sys_write(2, "lpm: error: "c as int64, 12);
  sys_write(2, s as int64, StrLen(s));
  sys_write(2, "\n"c as int64, 1);
}

// ---------------------------------------------------------------------------
// HOME-Verzeichnis aus envp lesen (envp = argv + (argc+1)*8)
// ---------------------------------------------------------------------------

fn cmdGetHome(argc: int64, argv: pchar): pchar {
  var envp: int64 := argv as int64 + (argc + 1) * 8;
  var i: int64 := 0;
  while true {
    var env: pchar := peek64(envp + i * 8) as pchar;
    if env == 0 as pchar { break; }
    // Check if env starts with "HOME="
    if StrLen(env) > 5 {
      var found: bool := true;
      var homeKey: pchar := "HOME="c;
      var j: int64 := 0;
      while j < 5 {
        if peek8(env as int64 + j) as int64 != peek8(homeKey as int64 + j) as int64 {
          found := false;
          j := 5;
        }
        j := j + 1;
      }
      if found { return (env as int64 + 5) as pchar; }
    }
    i := i + 1;
  }
  return "/root"c;
}

