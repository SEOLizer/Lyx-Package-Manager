// ---------------------------------------------------------------------------
// lpm init — schreibt lyx.toml direkt (ohne Manifest-Klasse, kein Alloc-Problem)
// ---------------------------------------------------------------------------

fn lpmInit(ctx: LpmCtx): int64 {
  if FileExists("lyx.toml"c) {
    cmdErr("lyx.toml existiert bereits in diesem Verzeichnis."c);
    return 1;
  }

  var pkgName: pchar := ctx.LcFlagVal("--name"c);
  if pkgName == 0 as pchar { pkgName := ctx.LcSubArg(0); }
  if pkgName == 0 as pchar { pkgName := "mypackage"c; }

  var tbuf: int64 := alloc(2048);
  var pos: int64 := 0;
  pos := cmdWrS(tbuf, pos, "[package]\n"c);
  pos := cmdWrS(tbuf, pos, "name        = \""c);
  pos := cmdWrS(tbuf, pos, pkgName);
  pos := cmdWrS(tbuf, pos, "\"\n"c);
  pos := cmdWrS(tbuf, pos, "version     = \"0.1.0\"\n"c);
  pos := cmdWrS(tbuf, pos, "author      = \"\"\n"c);
  pos := cmdWrS(tbuf, pos, "license     = \"MIT\"\n"c);
  pos := cmdWrS(tbuf, pos, "description = \"\"\n"c);
  pos := cmdWrS(tbuf, pos, "\n[build]\n"c);
  pos := cmdWrS(tbuf, pos, "entry       = \"main.lyx\"\n"c);

  var wfd: int64 := open("lyx.toml"c, 577, 420);  // O_WRONLY|O_CREAT|O_TRUNC, 0644
  if wfd < 0 {
    cmdErr("Konnte lyx.toml nicht schreiben."c);
    free(tbuf, 2048);
    return 1;
  }
  sys_write(wfd, tbuf, pos);
  close(wfd);
  free(tbuf, 2048);

  cmdOut("lpm: Paket '"c);
  cmdOut(pkgName);
  cmdOutLn("' initialisiert."c);
  cmdOutLn("lpm: lyx.toml wurde erstellt."c);
  return 0;
}

