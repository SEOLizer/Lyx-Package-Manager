// lpm/core/credentials.lyx
// WP-PM-08: Registry-Token lesen und schreiben.
//
// Der Token liegt in ~/.lpm/credentials, eine Zeile je Registry:
//
//   https://lpm.seolizer.de <token>
//
// Bewusst eine eigene Datei und nicht die Konfiguration: sie bekommt Modus
// 0600, und wer versehentlich sein ~/.lpm teilt, teilt dann wenigstens nicht
// beiliegend seine Upload-Rechte. Aus demselben Grund wird der Token nirgends
// ausgegeben — auch nicht unter --verbose.

@description("lpm registry credentials")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit lpm.core.credentials;

import std.io;
import std.fs;
import lpm.core.cache;

pub con CR_TOKEN_MAX: int64 := 512;

con CR_PATH_MAX: int64 := 4096;
con CR_FILE_MAX: int64 := 65536;
con CR_MODE:     int64 := 384;   // 0600

fn crAppend(buf: int64, pos: int64, s: pchar): int64 {
  if s == 0 as pchar { return pos; }
  var slen: int64 := StrLen(s);
  memcpy(buf + pos, s as int64, slen);
  return pos + slen;
}

// ~/.lpm/credentials — Aufrufer gibt den Puffer mit LpmCacheFreePath frei
// nicht zurueck, sondern per free(p, CR_PATH_MAX).
fn crPath(home: pchar): int64 {
  var buf: int64 := alloc(CR_PATH_MAX);
  var p: int64 := 0;
  p := crAppend(buf, p, home);
  p := crAppend(buf, p, "/.lpm/credentials"c);
  poke8(buf + p, 0);
  return buf;
}

// Vergleicht die ersten n Zeichen zweier Zeichenketten.
fn crEqN(a: int64, b: pchar, n: int64): bool {
  var i: int64 := 0;
  while i < n {
    if peek8(a + i) as int64 != peek8(b as int64 + i) as int64 { return false; }
    i := i + 1;
  }
  return true;
}

// Sucht den Token zu registry und schreibt ihn nach tokenOut (CR_TOKEN_MAX).
// Rueckgabe: true, wenn ein Eintrag gefunden wurde.
pub fn CrLoad(home: pchar, registry: pchar, tokenOut: int64): bool {
  poke8(tokenOut, 0);

  var path: int64 := crPath(home);
  if !FileExists(path as pchar) { free(path, CR_PATH_MAX); return false; }

  var size: int64 := FileSize(path as pchar);
  if size <= 0 { free(path, CR_PATH_MAX); return false; }
  if size > CR_FILE_MAX { free(path, CR_PATH_MAX); return false; }

  var buf: int64 := alloc(size + 1);
  var got: int64 := ReadFile(path as pchar, buf as pchar, size);
  free(path, CR_PATH_MAX);
  if got <= 0 { free(buf, size + 1); return false; }
  poke8(buf + got, 0);

  var rlen: int64 := StrLen(registry);
  var found: bool := false;
  var i: int64 := 0;

  while i < got {
    // Zeilenanfang: passt die Registry, gefolgt von einem Leerzeichen?
    var lineStart: int64 := i;
    var lineEnd: int64 := i;
    while lineEnd < got {
      if peek8(buf + lineEnd) as int64 == 10 { break; }
      lineEnd := lineEnd + 1;
    }

    if lineEnd - lineStart > rlen {
      if crEqN(buf + lineStart, registry, rlen) {
        if peek8(buf + lineStart + rlen) as int64 == 32 {
          var t: int64 := lineStart + rlen + 1;
          while t < lineEnd {
            if peek8(buf + t) as int64 != 32 { break; }
            t := t + 1;
          }
          var n: int64 := lineEnd - t;
          if n > 0 {
            if n < CR_TOKEN_MAX {
              memcpy(tokenOut, buf + t, n);
              poke8(tokenOut + n, 0);
              found := true;
            }
          }
        }
      }
    }

    if found { break; }
    i := lineEnd + 1;
  }

  free(buf, size + 1);
  return found;
}

// Legt den Token fuer registry ab und ersetzt einen vorhandenen Eintrag.
// Rueckgabe: true bei Erfolg.
pub fn CrStore(home: pchar, registry: pchar, token: pchar): bool {
  if !LpmCacheEnsure(home) { return false; }

  var path: int64 := crPath(home);

  // Vorhandene Zeilen uebernehmen, die zu einer anderen Registry gehoeren.
  var outCap: int64 := CR_FILE_MAX;
  var out: int64 := alloc(outCap);
  var op: int64 := 0;

  var rlen: int64 := StrLen(registry);

  if FileExists(path as pchar) {
    var size: int64 := FileSize(path as pchar);
    if size > 0 {
      if size <= CR_FILE_MAX {
        var buf: int64 := alloc(size + 1);
        var got: int64 := ReadFile(path as pchar, buf as pchar, size);
        if got > 0 {
          poke8(buf + got, 0);
          var i: int64 := 0;
          while i < got {
            var lineStart: int64 := i;
            var lineEnd: int64 := i;
            while lineEnd < got {
              if peek8(buf + lineEnd) as int64 == 10 { break; }
              lineEnd := lineEnd + 1;
            }
            var len: int64 := lineEnd - lineStart;

            var isSame: bool := false;
            if len > rlen {
              if crEqN(buf + lineStart, registry, rlen) {
                if peek8(buf + lineStart + rlen) as int64 == 32 { isSame := true; }
              }
            }

            if !isSame {
              if len > 0 {
                if op + len + 1 < outCap {
                  memcpy(out + op, buf + lineStart, len);
                  op := op + len;
                  poke8(out + op, 10);
                  op := op + 1;
                }
              }
            }
            i := lineEnd + 1;
          }
        }
        free(buf, size + 1);
      }
    }
  }

  // Neue Zeile anhaengen
  var need: int64 := rlen + 1 + StrLen(token) + 1;
  if op + need >= outCap {
    free(out, outCap);
    free(path, CR_PATH_MAX);
    return false;
  }
  op := crAppend(out, op, registry);
  poke8(out + op, 32); op := op + 1;
  op := crAppend(out, op, token);
  poke8(out + op, 10); op := op + 1;

  var wrote: int64 := WriteFile(path as pchar, out as pchar, op);
  var ok: bool := wrote == op;

  // Erst schreiben, dann die Rechte enger ziehen: WriteFile legt die Datei mit
  // den ueblichen 0644 an, und ein Token gehoert niemandem sonst.
  if ok { Chmod(path as pchar, CR_MODE); }

  free(out, outCap);
  free(path, CR_PATH_MAX);
  return ok;
}

// Entfernt den Eintrag zu registry. Rueckgabe: true, wenn danach keiner mehr
// da ist (auch wenn vorher keiner da war).
pub fn CrForget(home: pchar, registry: pchar): bool {
  var tok: int64 := alloc(CR_TOKEN_MAX);
  var had: bool := CrLoad(home, registry, tok);
  free(tok, CR_TOKEN_MAX);
  if !had { return true; }

  // Ueber CrStore mit leerem Token laesst sich das nicht ausdruecken — deshalb
  // hier derselbe Weg wie dort, nur ohne die neue Zeile.
  var path: int64 := crPath(home);
  var size: int64 := FileSize(path as pchar);
  if size <= 0 { free(path, CR_PATH_MAX); return true; }
  if size > CR_FILE_MAX { free(path, CR_PATH_MAX); return false; }

  var buf: int64 := alloc(size + 1);
  var got: int64 := ReadFile(path as pchar, buf as pchar, size);
  if got <= 0 {
    free(buf, size + 1);
    free(path, CR_PATH_MAX);
    return false;
  }
  poke8(buf + got, 0);

  var out: int64 := alloc(size + 1);
  var op: int64 := 0;
  var rlen: int64 := StrLen(registry);
  var i: int64 := 0;
  while i < got {
    var lineStart: int64 := i;
    var lineEnd: int64 := i;
    while lineEnd < got {
      if peek8(buf + lineEnd) as int64 == 10 { break; }
      lineEnd := lineEnd + 1;
    }
    var len: int64 := lineEnd - lineStart;

    var isSame: bool := false;
    if len > rlen {
      if crEqN(buf + lineStart, registry, rlen) {
        if peek8(buf + lineStart + rlen) as int64 == 32 { isSame := true; }
      }
    }
    if !isSame {
      if len > 0 {
        memcpy(out + op, buf + lineStart, len);
        op := op + len;
        poke8(out + op, 10);
        op := op + 1;
      }
    }
    i := lineEnd + 1;
  }

  var ok: bool := true;
  if op == 0 {
    ok := DeleteFile(path as pchar);
  } else {
    ok := WriteFile(path as pchar, out as pchar, op) == op;
    if ok { Chmod(path as pchar, CR_MODE); }
  }

  free(out, size + 1);
  free(buf, size + 1);
  free(path, CR_PATH_MAX);
  return ok;
}
